+HRESULT NativeWindow11Win32::createScrgbSwapChain(ID3D11Device *device,
+                                                  IDXGIFactory2 *factory2,
+                                                  DXGI_FORMAT format,
+                                                  UINT width,
+                                                  UINT height,
+                                                  UINT samples,
+                                                  IDXGISwapChain **swapChain)
+{
+    // DWM only honours a swap chain colour space on flip-model swap chains,
+    // which cannot be multisampled.
+    if (format != DXGI_FORMAT_R16G16B16A16_FLOAT || samples > 1)
+    {
+        return DXGI_ERROR_UNSUPPORTED;
+    }
+    DXGI_SWAP_CHAIN_DESC1 swapChainDesc = {};
+    swapChainDesc.Width                 = width;
+    swapChainDesc.Height                = height;
+    swapChainDesc.Format                = format;
+    swapChainDesc.Stereo                = FALSE;
+    swapChainDesc.SampleDesc.Count      = 1;
+    swapChainDesc.SampleDesc.Quality    = 0;
+    swapChainDesc.BufferUsage =
+        DXGI_USAGE_RENDER_TARGET_OUTPUT | DXGI_USAGE_SHADER_INPUT | DXGI_USAGE_BACK_BUFFER;
+    swapChainDesc.BufferCount   = 2;
+    swapChainDesc.Scaling       = DXGI_SCALING_STRETCH;
+    swapChainDesc.SwapEffect    = DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL;
+    swapChainDesc.AlphaMode     = DXGI_ALPHA_MODE_UNSPECIFIED;
+    swapChainDesc.Flags         = 0;
+    IDXGISwapChain1 *swapChain1 = nullptr;
+    HRESULT result = factory2->CreateSwapChainForHwnd(device, getNativeWindow(), &swapChainDesc,
+                                                      nullptr, nullptr, &swapChain1);
+    if (FAILED(result))
+    {
+        return result;
+    }
+
+    IDXGISwapChain3 *swapChain3 = d3d11::DynamicCastComObject<IDXGISwapChain3>(swapChain1);
+    UINT support                = 0;
+    const DXGI_COLOR_SPACE_TYPE colorSpace = DXGI_COLOR_SPACE_RGB_FULL_G10_NONE_P709;
+    if (swapChain3 == nullptr ||
+        FAILED(swapChain3->CheckColorSpaceSupport(colorSpace, &support)) ||
+        (support & DXGI_SWAP_CHAIN_COLOR_SPACE_SUPPORT_FLAG_PRESENT) == 0 ||
+        FAILED(swapChain3->SetColorSpace1(colorSpace)))
+    {
+        SafeRelease(swapChain3);
+        SafeRelease(swapChain1);
+        return DXGI_ERROR_UNSUPPORTED;
+    }
+    SafeRelease(swapChain3);
+
+    factory2->MakeWindowAssociation(getNativeWindow(), DXGI_MWA_NO_ALT_ENTER);
+    *swapChain = static_cast<IDXGISwapChain *>(swapChain1);
+    return S_OK;
+}

+
+// Fushi patch (keyed mutex external textures, BUG-3888).
+//
+// A legacy shared texture (D3D11_RESOURCE_MISC_SHARED) written on the
+// producer's device and sampled here is only serialized implicitly by the OS,
+// and the producer can overwrite it while a frame that samples it is still in
+// flight. With D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX both sides must hold the
+// key around every access, so the engine never binds the shared texture to GL
+// at all: per new frame it takes key 0 without waiting, copies the texture
+// into an engine-owned one on ANGLE's device and gives the key back at once.
+// GL samples only the engine-owned copy, which the producer cannot touch, and
+// the key is never held across ANGLE's draws (releasing a keyed mutex unbinds
+// the resource behind ANGLE's state cache).
+//
+// The D3D11 calls run on ANGLE's immediate context outside ANGLE's lock; the
+// egl::Manager made that context multithread protected at creation.
+ExternalTextureD3d::SharedTextureKind ExternalTextureD3d::OpenKeyedMutexTexture(
+    HANDLE handle) {
+  ID3D11Device* device = egl_manager_->d3d11_device();
+  if (device == nullptr) {
+    return SharedTextureKind::kPlain;
+  }
+  Microsoft::WRL::ComPtr<ID3D11Texture2D> shared;
+  if (FAILED(device->OpenSharedResource(handle,
+                                        IID_PPV_ARGS(shared.GetAddressOf())))) {
+    // Not openable here: let the stock path report the failure.
+    return SharedTextureKind::kPlain;
+  }
+  D3D11_TEXTURE2D_DESC desc = {};
+  shared->GetDesc(&desc);
+  if ((desc.MiscFlags & D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX) == 0) {
+    return SharedTextureKind::kPlain;
+  }
+  if (egl_manager_->protected_device() == nullptr) {
+    FML_LOG(ERROR) << "Keyed mutex texture: ANGLE's device is not multithread "
+                      "protected; not showing it.";
+    return SharedTextureKind::kUnusable;
+  }
+  Microsoft::WRL::ComPtr<IDXGIKeyedMutex> keyed_mutex;
+  if (FAILED(shared.As(&keyed_mutex))) {
+    FML_LOG(ERROR) << "Keyed mutex texture: IDXGIKeyedMutex unavailable.";
+    return SharedTextureKind::kUnusable;
+  }
+  D3D11_TEXTURE2D_DESC private_desc = desc;
+  private_desc.MiscFlags = 0;
+  private_desc.CPUAccessFlags = 0;
+  private_desc.Usage = D3D11_USAGE_DEFAULT;
+  // ANGLE wraps the copy as a pbuffer: it samples it and creates an RTV.
+  private_desc.BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
+  Microsoft::WRL::ComPtr<ID3D11Texture2D> private_texture;
+  if (FAILED(device->CreateTexture2D(&private_desc, nullptr,
+                                     private_texture.GetAddressOf()))) {
+    FML_LOG(ERROR) << "Keyed mutex texture: creating the engine copy failed.";
+    return SharedTextureKind::kUnusable;
+  }
+  shared_texture_ = std::move(shared);
+  keyed_mutex_ = std::move(keyed_mutex);
+  private_texture_ = std::move(private_texture);
+  has_private_frame_ = false;
+  return SharedTextureKind::kKeyedMutex;
+}
+
+bool ExternalTextureD3d::CopyUnderKeyedMutex() {
+  ID3D11Device* device = egl_manager_->protected_device();
+  if (device == nullptr) {
+    return has_private_frame_;
+  }
+  // Never wait: the producer holds key 0 only for its own CopyResource. If
+  // it holds it right now, keep showing the previous copy; the producer
+  // marks the texture dirty again after it releases, which re-resolves it.
+  const HRESULT acquired = keyed_mutex_->AcquireSync(0, 0);
+  if (acquired == static_cast<HRESULT>(WAIT_TIMEOUT)) {
+    return has_private_frame_;
+  }
+  if (FAILED(acquired)) {
+    FML_LOG(ERROR) << "Keyed mutex texture: AcquireSync failed: 0x" << std::hex
+                   << static_cast<unsigned long>(acquired);
+    return has_private_frame_;
+  }
+  // S_OK, or WAIT_ABANDONED (the producer's device went away while holding
+  // the key; we own it now and the content is whatever it last finished).
+  Microsoft::WRL::ComPtr<ID3D11DeviceContext> context;
+  device->GetImmediateContext(context.GetAddressOf());
+  context->CopyResource(private_texture_.Get(), shared_texture_.Get());
+  const HRESULT released = keyed_mutex_->ReleaseSync(0);
+  if (FAILED(released)) {
+    FML_LOG(ERROR) << "Keyed mutex texture: ReleaseSync failed: 0x" << std::hex
+                   << static_cast<unsigned long>(released);
+  }
+  has_private_frame_ = true;
+  return true;
 }
 

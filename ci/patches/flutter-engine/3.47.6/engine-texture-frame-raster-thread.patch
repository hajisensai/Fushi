+// Fushi patch (texture frames on the raster thread): a producer thread's mark
+// reaches the engine on that same thread, synchronously -- no task is queued
+// on the platform thread (which, merged with the UI thread, may be busy).
+TEST(FlutterWindowsTextureRegistrarTest,
+     MarkFrameAvailableFromProducerThreadSkipsPlatformThread) {
+  std::unique_ptr<FlutterWindowsEngine> engine = GetTestEngine();
+  EngineModifier modifier(engine.get());
+  auto gl = std::make_shared<egl::MockProcTable>();
+
+  FlutterWindowsTextureRegistrar registrar(engine.get(), gl);
+
+  modifier.embedder_api().MarkExternalTextureFrameAvailable = MOCK_ENGINE_PROC(
+      MarkExternalTextureFrameAvailable, ([](auto engine, auto texture_id) {
+        ADD_FAILURE() << "texture marks must not need the platform thread";
+        return kSuccess;
+      }));
+  std::thread::id marked_on;
+  int64_t marked_texture = 0;
+  modifier.embedder_api().MarkExternalTextureFrameAvailableOnRasterThread =
+      MOCK_ENGINE_PROC(MarkExternalTextureFrameAvailableOnRasterThread,
+                       ([&marked_on, &marked_texture](auto engine,
+                                                      auto texture_id) {
+                         marked_on = std::this_thread::get_id();
+                         marked_texture = texture_id;
+                         return kSuccess;
+                       }));
+
+  bool result = false;
+  std::thread::id producer;
+  std::thread producer_thread([&]() {
+    producer = std::this_thread::get_id();
+    result = registrar.MarkTextureFrameAvailable(42);
+  });
+  producer_thread.join();
+
+  EXPECT_TRUE(result);
+  EXPECT_EQ(marked_texture, 42);
+  EXPECT_EQ(marked_on, producer);
+  EXPECT_NE(marked_on, std::this_thread::get_id());
+}

+// Fushi patch (texture frames on the raster thread).
+//
+// |MarkTextureFrameAvailable| above must run on the platform thread and then
+// waits for the |Animator| on the UI thread: next vsync, then
+// |DrawLastLayerTrees| posted back to the raster thread. With merged platform
+// and UI threads (the Windows default) every external texture frame therefore
+// waits behind whatever the Dart isolate and the Win32 message loop are doing;
+// a busy main thread longer than one video frame drops video frames even when
+// decoder, renderer and raster thread are idle.
+//
+// Here the producer's thread posts straight to the raster thread, which marks
+// the texture and redraws the last layer trees itself -- the same raster-side
+// work the |Animator| would have requested, minus the main-thread round trip.
+// The layer trees are the last ones the framework produced, so nothing the
+// framework drew is changed or skipped; a frame the framework builds later is
+// drawn by the regular pipeline as before. Like |PostRenderThreadTask| (which
+// stock embedders already call from arbitrary threads, e.g. Windows' texture
+// unregistration), this only touches the shell through its task runners and
+// the rasterizer's raster-thread-affine weak pointer.
+bool EmbedderEngine::MarkTextureFrameAvailableOnRasterThread(int64_t texture) {
+  if (!IsValid()) {
+    return false;
+  }
+  std::shared_ptr<RasterTextureRedraw> state = raster_texture_redraw_;
+  {
+    std::scoped_lock lock(state->mutex);
+    state->marked.push_back(texture);
+    if (state->scheduled) {
+      // The queued redraw has not swapped |marked| yet; it picks this one up.
+      return true;
+    }
+    state->scheduled = true;
+  }
+
+  double refresh_rate = shell_->GetMainDisplayRefreshRate();
+  if (!(refresh_rate > 0.0)) {
+    refresh_rate = 60.0;
+  }
+  const fml::TimeDelta frame_interval =
+      fml::TimeDelta::FromSecondsF(1.0 / refresh_rate);
+
+  shell_->GetTaskRunners().GetRasterTaskRunner()->PostTask(
+      [state, rasterizer = shell_->GetRasterizer(), frame_interval]() {
+        std::vector<int64_t> marked;
+        {
+          std::scoped_lock lock(state->mutex);
+          marked.swap(state->marked);
+          // Marks from here on queue the next redraw: they may have produced
+          // a frame this redraw no longer samples.
+          state->scheduled = false;
+        }
+        if (!rasterizer) {
+          return;
+        }
+        std::shared_ptr<TextureRegistry> registry =
+            rasterizer->GetTextureRegistry();
+        if (!registry) {
+          return;
+        }
+        for (int64_t texture_id : marked) {
+          std::shared_ptr<Texture> marked_texture =
+              registry->GetTexture(texture_id);
+          if (marked_texture) {
+            marked_texture->MarkNewFrameAvailable();
+          }
+        }
+        // As in |Animator::DrawLastLayerTrees|: nothing is built, so build
+        // start and end are both "now".
+        auto recorder = std::make_unique<FrameTimingsRecorder>();
+        const fml::TimePoint now = fml::TimePoint::Now();
+        recorder->RecordVsync(now, now + frame_interval);
+        recorder->RecordBuildStart(now);
+        recorder->RecordBuildEnd(now);
+        rasterizer->DrawLastLayerTrees(std::move(recorder));
+      });
+  return true;
+}

+// The framework lists children it never sends (Fushi BUG-4333: "Nodes left
+// pending by the update"). The AXTree used to reject the update after it had
+// already created the pending nodes, leaving AXNodes without delegates.
+TEST(AccessibilityBridgeTest, ChildWithoutDataIsNotLeftPending) {
+  std::shared_ptr<TestAccessibilityBridge> bridge =
+      std::make_shared<TestAccessibilityBridge>();
+
+  std::vector<int32_t> root_children{1};
+  FlutterSemanticsNode2 root = CreateSemanticsNode(0, "root", &root_children);
+  FlutterSemanticsNode2 child1 = CreateSemanticsNode(1, "child 1");
+  bridge->AddFlutterSemanticsNodeUpdate(root);
+  bridge->AddFlutterSemanticsNodeUpdate(child1);
+  bridge->CommitUpdates();
+
+  std::vector<int32_t> new_root_children{1, 2, 3, 4};
+  root.child_count = new_root_children.size();
+  root.children_in_traversal_order = new_root_children.data();
+  bridge->AddFlutterSemanticsNodeUpdate(root);
+  bridge->CommitUpdates();
+
+  auto root_node = bridge->GetFlutterPlatformNodeDelegateFromID(0).lock();
+  ASSERT_TRUE(root_node);
+  EXPECT_EQ(root_node->GetChildCount(), 1);
+  EXPECT_EQ(root_node->GetData().child_ids, std::vector<int32_t>{1});
+  EXPECT_TRUE(bridge->GetFlutterPlatformNodeDelegateFromID(1).lock());
+  EXPECT_FALSE(bridge->GetFlutterPlatformNodeDelegateFromID(2).lock());
+  EXPECT_FALSE(bridge->GetTree()->GetFromId(2));
+  // An index past the children the tree holds is not dereferenced.
+  EXPECT_EQ(root_node->ChildAtIndex(3), nullptr);
+
+  // The children attach as soon as their data arrives; the framework does
+  // not resend the root.
+  FlutterSemanticsNode2 child2 = CreateSemanticsNode(2, "child 2");
+  FlutterSemanticsNode2 child3 = CreateSemanticsNode(3, "child 3");
+  FlutterSemanticsNode2 child4 = CreateSemanticsNode(4, "child 4");
+  bridge->AddFlutterSemanticsNodeUpdate(child2);
+  bridge->AddFlutterSemanticsNodeUpdate(child3);
+  bridge->AddFlutterSemanticsNodeUpdate(child4);
+  bridge->CommitUpdates();
+
+  root_node = bridge->GetFlutterPlatformNodeDelegateFromID(0).lock();
+  ASSERT_TRUE(root_node);
+  EXPECT_EQ(root_node->GetData().child_ids, new_root_children);
+  for (int32_t id : {2, 3, 4}) {
+    auto node = bridge->GetFlutterPlatformNodeDelegateFromID(id).lock();
+    ASSERT_TRUE(node) << id;
+    EXPECT_EQ(node->GetName(), "child " + std::to_string(id));
+  }
+}
+
+// A node sent while no parent lists it (Fushi BUG-2839, BUG-4073: "N will not
+// be in the tree and is not the new root") is kept until a parent lists it.
+TEST(AccessibilityBridgeTest, NodeSentBeforeAnyParentListsItAttachesLater) {
+  std::shared_ptr<TestAccessibilityBridge> bridge =
+      std::make_shared<TestAccessibilityBridge>();
+
+  std::vector<int32_t> root_children{1};
+  FlutterSemanticsNode2 root = CreateSemanticsNode(0, "root", &root_children);
+  FlutterSemanticsNode2 child1 = CreateSemanticsNode(1, "child 1");
+  bridge->AddFlutterSemanticsNodeUpdate(root);
+  bridge->AddFlutterSemanticsNodeUpdate(child1);
+  bridge->CommitUpdates();
+
+  FlutterSemanticsNode2 orphan = CreateSemanticsNode(5, "orphan");
+  bridge->AddFlutterSemanticsNodeUpdate(orphan);
+  bridge->CommitUpdates();
+
+  EXPECT_FALSE(bridge->GetFlutterPlatformNodeDelegateFromID(5).lock());
+  EXPECT_FALSE(bridge->GetTree()->GetFromId(5));
+  auto root_node = bridge->GetFlutterPlatformNodeDelegateFromID(0).lock();
+  ASSERT_TRUE(root_node);
+  EXPECT_EQ(root_node->GetData().child_ids, std::vector<int32_t>{1});
+
+  // A later update can list it without resending it.
+  std::vector<int32_t> new_root_children{1, 5};
+  root.child_count = new_root_children.size();
+  root.children_in_traversal_order = new_root_children.data();
+  bridge->AddFlutterSemanticsNodeUpdate(root);
+  bridge->CommitUpdates();
+
+  auto orphan_node = bridge->GetFlutterPlatformNodeDelegateFromID(5).lock();
+  ASSERT_TRUE(orphan_node);
+  EXPECT_EQ(orphan_node->GetName(), "orphan");
+  EXPECT_EQ(orphan_node->GetAXNode()->parent()->id(), 0);
+}
+
+// A child moved to a new parent without being resent (the old code asserted
+// in debug builds and, in release, erased end() from the old parent's
+// children in CreateRemoveReparentedNodesUpdate; Fushi BUG-3796). Moving it
+// destroys its subtree in the first AXTree update, so the bridge has to
+// re-create the whole subtree from the data it already has.
+TEST(AccessibilityBridgeTest, MovedChildThatIsNotResentKeepsItsSubtree) {
+  std::shared_ptr<TestAccessibilityBridge> bridge =
+      std::make_shared<TestAccessibilityBridge>();
+
+  std::vector<int32_t> root_children{1, 2};
+  std::vector<int32_t> child1_children{3};
+  std::vector<int32_t> child3_children{4};
+  FlutterSemanticsNode2 root = CreateSemanticsNode(0, "root", &root_children);
+  FlutterSemanticsNode2 child1 =
+      CreateSemanticsNode(1, "child 1", &child1_children);
+  FlutterSemanticsNode2 child2 = CreateSemanticsNode(2, "child 2");
+  FlutterSemanticsNode2 child3 =
+      CreateSemanticsNode(3, "child 3", &child3_children);
+  FlutterSemanticsNode2 child4 = CreateSemanticsNode(4, "child 4");
+  bridge->AddFlutterSemanticsNodeUpdate(root);
+  bridge->AddFlutterSemanticsNodeUpdate(child1);
+  bridge->AddFlutterSemanticsNodeUpdate(child2);
+  bridge->AddFlutterSemanticsNodeUpdate(child3);
+  bridge->AddFlutterSemanticsNodeUpdate(child4);
+  bridge->CommitUpdates();
+
+  // Only the new parent is sent: child 1 (the old parent) still lists 3 in the
+  // last data the framework sent for it, and 3 / 4 are not resent.
+  std::vector<int32_t> new_child2_children{3};
+  child2.child_count = new_child2_children.size();
+  child2.children_in_traversal_order = new_child2_children.data();
+  bridge->AddFlutterSemanticsNodeUpdate(child2);
+  bridge->CommitUpdates();
+
+  auto child1_node = bridge->GetFlutterPlatformNodeDelegateFromID(1).lock();
+  auto child2_node = bridge->GetFlutterPlatformNodeDelegateFromID(2).lock();
+  auto child3_node = bridge->GetFlutterPlatformNodeDelegateFromID(3).lock();
+  auto child4_node = bridge->GetFlutterPlatformNodeDelegateFromID(4).lock();
+  ASSERT_TRUE(child1_node);
+  ASSERT_TRUE(child2_node);
+  ASSERT_TRUE(child3_node);
+  ASSERT_TRUE(child4_node);
+  EXPECT_EQ(child1_node->GetChildCount(), 0);
+  // The old parent was not resent either; it is re-serialized from its last
+  // data with the children it keeps, so it no longer describes itself as a
+  // parent.
+  EXPECT_EQ(child1_node->GetData().role, ax::mojom::Role::kStaticText);
+  EXPECT_FALSE(child1_node->GetData().GetBoolAttribute(
+      ax::mojom::BoolAttribute::kClipsChildren));
+  EXPECT_EQ(child2_node->GetData().child_ids, std::vector<int32_t>{3});
+  EXPECT_EQ(child2_node->GetData().role, ax::mojom::Role::kGroup);
+  EXPECT_EQ(child3_node->GetData().child_ids, std::vector<int32_t>{4});
+  EXPECT_EQ(child3_node->GetName(), "child 3");
+  EXPECT_EQ(child4_node->GetName(), "child 4");
+  // The delegates point at the AXNodes the tree holds now.
+  EXPECT_EQ(child3_node->GetAXNode(), bridge->GetTree()->GetFromId(3));
+  EXPECT_EQ(child4_node->GetAXNode(), bridge->GetTree()->GetFromId(4));
+}
+
+// The same child listed under two parents in one update ("Node N is not
+// marked for destruction, would be reparented") ends up under one of them.
+TEST(AccessibilityBridgeTest, ChildListedByTwoParentsIsPlacedOnce) {
+  std::shared_ptr<TestAccessibilityBridge> bridge =
+      std::make_shared<TestAccessibilityBridge>();
+
+  std::vector<int32_t> root_children{1, 2};
+  std::vector<int32_t> shared_children{3};
+  FlutterSemanticsNode2 root = CreateSemanticsNode(0, "root", &root_children);
+  FlutterSemanticsNode2 child1 =
+      CreateSemanticsNode(1, "child 1", &shared_children);
+  FlutterSemanticsNode2 child2 =
+      CreateSemanticsNode(2, "child 2", &shared_children);
+  FlutterSemanticsNode2 child3 = CreateSemanticsNode(3, "child 3");
+  bridge->AddFlutterSemanticsNodeUpdate(root);
+  bridge->AddFlutterSemanticsNodeUpdate(child1);
+  bridge->AddFlutterSemanticsNodeUpdate(child2);
+  bridge->AddFlutterSemanticsNodeUpdate(child3);
+  bridge->CommitUpdates();
+
+  auto child1_node = bridge->GetFlutterPlatformNodeDelegateFromID(1).lock();
+  auto child2_node = bridge->GetFlutterPlatformNodeDelegateFromID(2).lock();
+  auto child3_node = bridge->GetFlutterPlatformNodeDelegateFromID(3).lock();
+  ASSERT_TRUE(child1_node);
+  ASSERT_TRUE(child2_node);
+  ASSERT_TRUE(child3_node);
+  EXPECT_EQ(child1_node->GetData().child_ids, std::vector<int32_t>{3});
+  EXPECT_EQ(child2_node->GetChildCount(), 0);
+  EXPECT_EQ(child3_node->GetAXNode()->parent()->id(), 1);
+}
+
+// Nodes are re-serialized from the bridge's own copy when their children
+// change without the framework resending them, so the copy must not point
+// into the embedder's update buffer.
+TEST(AccessibilityBridgeTest, NodeDataOutlivesTheUpdateBuffer) {
+  std::shared_ptr<TestAccessibilityBridge> bridge =
+      std::make_shared<TestAccessibilityBridge>();
+
+  std::vector<int32_t> root_children{1};
+  std::vector<int32_t> button_children{2};
+  FlutterSemanticsNode2 root = CreateSemanticsNode(0, "root", &root_children);
+  FlutterSemanticsNode2 button =
+      CreateSemanticsNode(1, "button", &button_children);
+  FlutterSemanticsFlags button_flags = FlutterSemanticsFlags{};
+  button_flags.is_button = true;
+  button.flags2 = &button_flags;
+  bridge->AddFlutterSemanticsNodeUpdate(root);
+  bridge->AddFlutterSemanticsNodeUpdate(button);
+  bridge->CommitUpdates();
+
+  auto button_node = bridge->GetFlutterPlatformNodeDelegateFromID(1).lock();
+  ASSERT_TRUE(button_node);
+  EXPECT_EQ(button_node->GetData().role, ax::mojom::Role::kButton);
+  EXPECT_EQ(button_node->GetChildCount(), 0);
+
+  // The update buffer is gone (reused) by the next frame.
+  button_flags.is_button = false;
+
+  // Child 2 arrives: node 1 is re-serialized with its new child from the
+  // bridge's copy.
+  FlutterSemanticsNode2 child2 = CreateSemanticsNode(2, "child 2");
+  bridge->AddFlutterSemanticsNodeUpdate(child2);
+  bridge->CommitUpdates();
+
+  button_node = bridge->GetFlutterPlatformNodeDelegateFromID(1).lock();
+  ASSERT_TRUE(button_node);
+  EXPECT_EQ(button_node->GetData().child_ids, std::vector<int32_t>{2});
+  EXPECT_EQ(button_node->GetData().role, ax::mojom::Role::kButton);
+}
+
+// Custom actions are only sent with the frame that introduces them; a node

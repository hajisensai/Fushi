+AccessibilityNodeId AccessibilityBridge::PickRootId(
+    const std::unordered_set<int32_t>& updated_ids) const {
+  // The root is the node no other node lists. If the first update also carries
+  // nodes no parent lists, the candidate with the largest subtree is the root.
+  std::unordered_set<int32_t> listed;
+  for (int32_t id : updated_ids) {
+    for (int32_t child : semantics_nodes_.at(id).children_in_traversal_order) {
+      if (child != id) {
+        listed.insert(child);
+      }
+    }
+  }
+
+  AccessibilityNodeId root = ui::AXNode::kInvalidAXID;
+  size_t root_subtree_size = 0;
+  for (int32_t id : updated_ids) {
+    if (listed.find(id) != listed.end()) {
+      continue;
+    }
+    std::unordered_set<int32_t> seen{id};
+    std::vector<int32_t> stack{id};
+    while (!stack.empty()) {
+      int32_t current = stack.back();
+      stack.pop_back();
+      auto node = semantics_nodes_.find(current);
+      if (node == semantics_nodes_.end()) {
+        continue;
+      }
+      for (int32_t child : node->second.children_in_traversal_order) {
+        if (seen.insert(child).second) {
+          stack.push_back(child);
+        }
+      }
+    }
+    if (seen.size() > root_subtree_size ||
+        (seen.size() == root_subtree_size && id < root)) {
+      root = id;
+      root_subtree_size = seen.size();
+    }
+  }
+  return root;
+}
+
+AccessibilityBridge::TreePlan AccessibilityBridge::PlanTree(
+    const std::unordered_set<int32_t>& updated_ids) const {
+  TreePlan plan = PlanTreeWithClaims({});
+
+  // A child listed by two parents goes to whichever the depth-first walk meets
+  // first. If one of them was sent in this commit, it carries the framework's
+  // newer intent (the other one is stale, e.g. a moved child whose old parent
+  // was not resent), so it keeps the child. Sorted for a deterministic result
+  // when two updated parents claim the same child.
+  std::vector<int32_t> claimants;
+  for (int32_t id : updated_ids) {
+    if (plan.parent.find(id) != plan.parent.end()) {
+      claimants.push_back(id);
+    }
+  }
+  std::sort(claimants.begin(), claimants.end());
+
+  std::unordered_map<int32_t, int32_t> claims;
+  bool conflict = false;
+  for (int32_t parent : claimants) {
+    for (int32_t child :
+         semantics_nodes_.at(parent).children_in_traversal_order) {
+      if (child == root_id_ || child == parent ||
+          semantics_nodes_.find(child) == semantics_nodes_.end() ||
+          !claims.emplace(child, parent).second) {
+        continue;
+      }
+      auto placed = plan.parent.find(child);
+      if (placed != plan.parent.end() && placed->second != parent) {
+        conflict = true;
+      }
+    }
+  }
+  if (!conflict) {
+    return plan;
+  }
+  return PlanTreeWithClaims(claims);
+}
+
+AccessibilityBridge::TreePlan AccessibilityBridge::PlanTreeWithClaims(
+    const std::unordered_map<int32_t, int32_t>& claims) const {
+  TreePlan plan;
+  if (root_id_ == ui::AXNode::kInvalidAXID ||
+      semantics_nodes_.find(root_id_) == semantics_nodes_.end()) {
+    return plan;
+  }
+
+  // Iterative pre-order walk: a parent is always emitted before its children,
+  // which is the order the AXTree requires within an update. A node is placed
+  // under the first parent that lists it, so the result is a tree even if the
+  // framework lists a node twice or forms a cycle.
+  std::unordered_set<int32_t> placed{root_id_};
+  std::vector<int32_t> stack{root_id_};
+  plan.parent[root_id_] = ui::AXNode::kInvalidAXID;
+  while (!stack.empty()) {
+    int32_t id = stack.back();
+    stack.pop_back();
+    plan.order.push_back(id);
+
+    std::vector<int32_t>& children = plan.children[id];
+    for (int32_t child : semantics_nodes_.at(id).children_in_traversal_order) {
+      auto claim = claims.find(child);
+      if (semantics_nodes_.find(child) == semantics_nodes_.end() ||
+          (claim != claims.end() && claim->second != id) ||
+          !placed.insert(child).second) {
+        plan.dropped_children++;
+        continue;
+      }
+      children.push_back(child);
+      plan.parent[child] = id;
+    }
+    for (auto child = children.rbegin(); child != children.rend(); ++child) {
+      stack.push_back(*child);
+    }
+  }
+  return plan;
+}

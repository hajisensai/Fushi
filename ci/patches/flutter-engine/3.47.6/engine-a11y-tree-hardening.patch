+bool AccessibilityBridge::ApplyTreePlan(
+    const TreePlan& plan,
+    const std::unordered_set<int32_t>& updated_ids) {
+  const bool tree_is_empty =
+      GetRootAsAXNode()->id() == ui::AXNode::kInvalidAXID;
+  if (!tree_is_empty && GetRootAsAXNode()->id() != root_id_) {
+    // A tree's root never changes.
+    FML_LOG(ERROR) << "Accessibility tree root " << GetRootAsAXNode()->id()
+                   << " does not match the semantics root " << root_id_;
+    return false;
+  }
+
+  // AXTree cannot move a node in a single update. This must be split across
+  // two updates:
+  //
+  // * Update 1: remove moved nodes from their old parents. This destroys the
+  //   moved nodes together with their subtrees.
+  // * Update 2: add the nodes (including their children) to their new
+  //   parents, along with every other node whose data or children changed.
+  std::vector<int32_t> moved;
+  if (!tree_is_empty) {
+    for (int32_t id : plan.order) {
+      if (id == root_id_) {
+        continue;
+      }
+      ui::AXNode* node = tree_->GetFromId(id);
+      if (node &&
+          (!node->parent() || node->parent()->id() != plan.parent.at(id))) {
+        moved.push_back(id);
+      }
+    }
+  }
+
+  // Old parents that update 1 edits from the AXTree's own data. Their role
+  // and attributes still describe the children they lost, so update 2 must
+  // re-serialize them from the semantics data even when the framework did not
+  // resend them.
+  std::unordered_set<int32_t> stripped_parents;
+  if (!moved.empty()) {
+    std::unordered_set<int32_t> destroyed;
+    for (int32_t id : moved) {
+      std::vector<ui::AXNode*> stack{tree_->GetFromId(id)};
+      while (!stack.empty()) {
+        ui::AXNode* node = stack.back();
+        stack.pop_back();
+        if (!destroyed.insert(node->id()).second) {
+          continue;
+        }
+        for (ui::AXNode* child : node->children()) {
+          stack.push_back(child);
+        }
+      }
+    }
+
+    std::unordered_map<int32_t, ui::AXNodeData> old_parents;
+    for (int32_t id : moved) {
+      ui::AXNode* old_parent = tree_->GetFromId(id)->parent();
+      // A node nested in another moved subtree goes away with that subtree.
+      if (!old_parent || destroyed.find(old_parent->id()) != destroyed.end()) {
+        continue;
+      }
+      stripped_parents.insert(old_parent->id());
+      auto entry = old_parents.find(old_parent->id());
+      if (entry == old_parents.end()) {
+        entry = old_parents.emplace(old_parent->id(), old_parent->data()).first;
+      }
+      std::vector<int32_t>& child_ids = entry->second.child_ids;
+      child_ids.erase(std::remove(child_ids.begin(), child_ids.end(), id),
+                      child_ids.end());
+    }
+
+    ui::AXTreeUpdate remove_moved;
+    remove_moved.root_id = root_id_;
+    remove_moved.tree_data = tree_->data();
+    for (auto& old_parent : old_parents) {
+      remove_moved.nodes.push_back(std::move(old_parent.second));
+    }
+    if (!remove_moved.nodes.empty() && !tree_->Unserialize(remove_moved)) {
+      FML_LOG(ERROR) << "Failed to update ui::AXTree, error: "
+                     << tree_->error();
+      return false;
+    }
+  }
+
+  ui::AXTreeUpdate update;
+  update.root_id = root_id_;
+  update.tree_data = tree_->data();
+  for (int32_t id : plan.order) {
+    const std::vector<int32_t>& children = plan.children.at(id);
+    ui::AXNode* node = tree_is_empty ? nullptr : tree_->GetFromId(id);
+    if (node && updated_ids.find(id) == updated_ids.end() &&
+        stripped_parents.find(id) == stripped_parents.end() &&
+        node->data().child_ids == children) {
+      // Unchanged, and already in the tree under the same parent.
+      continue;
+    }
+    ConvertFlutterUpdate(semantics_nodes_.at(id), children, update);
+  }
+  if (update.nodes.empty() && !update.has_tree_data) {
+    return true;
+  }
+  if (!tree_->Unserialize(update)) {
+    FML_LOG(ERROR) << "Failed to update ui::AXTree, error: " << tree_->error();
+    return false;
+  }
+  return true;
+}
+
+void AccessibilityBridge::ResetTree() {
+  // Order matters: events and delegates reference AXNodes of the old tree,
+  // which may have been destroyed by a rejected update without the observers
+  // being told. Drop them before anything can read them. Destroying a delegate
+  // destroys its platform node, so UIA / MSAA clients that still hold it get
+  // "element not available" instead of reading freed memory.
+  event_generator_.ClearEvents();
+  event_generator_.ReleaseTree();
+  tree_->RemoveObserver(static_cast<ui::AXTreeObserver*>(this));
+  id_wrapper_map_.clear();
+
+  // Keep the tree id: AXTreeManagerMap and the platform nodes find this
+  // bridge by it.
+  ui::AXTreeData data = tree_->data();
+  data.focus_id = ui::AXNode::kInvalidAXID;
+  data.sel_anchor_object_id = ui::AXNode::kInvalidAXID;
+  data.sel_anchor_offset = -1;
+  data.sel_focus_object_id = ui::AXNode::kInvalidAXID;
+  data.sel_focus_offset = -1;
+  tree_ = std::make_unique<ui::AXTree>();
+  tree_->UpdateData(data);
+  event_generator_.SetTree(tree_.get());
+  tree_->AddObserver(static_cast<ui::AXTreeObserver*>(this));
+}
+
+void AccessibilityBridge::RebuildTree(const TreePlan& plan) {
+  FML_LOG(ERROR) << "Rebuilding the accessibility tree from the last known "
+                    "semantics of "
+                 << plan.order.size() << " nodes.";
+  ResetTree();
+
+  ui::AXTreeUpdate update;
+  update.root_id = root_id_;
+  update.tree_data = tree_->data();
+  for (int32_t id : plan.order) {
+    ConvertFlutterUpdate(semantics_nodes_.at(id), plan.children.at(id), update);
+  }
+  if (!tree_->Unserialize(update)) {
+    // |plan| is a tree by construction, so this is not expected. Never keep a
+    // half-applied tree: fall back to an empty one that matches the (empty)
+    // delegate map until the next update.
+    FML_LOG(ERROR) << "Failed to rebuild ui::AXTree, error: " << tree_->error();
+    ResetTree();
+  }
+
+  if (last_focused_id_ != ui::AXNode::kInvalidAXID &&
+      !tree_->GetFromId(last_focused_id_)) {
+    last_focused_id_ = ui::AXNode::kInvalidAXID;
+  }
+}

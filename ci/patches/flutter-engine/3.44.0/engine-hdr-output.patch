+std::unique_ptr<egl::WindowSurface>
+FlutterWindowsView::CreateWindowSurfaceForOutput(size_t width,
+                                                 size_t height) const {
+  egl::Manager* manager = engine_->egl_manager();
+  if (manager == nullptr) {
+    return nullptr;
+  }
+  if (hdr_output_requested() && manager->SupportsHdrSurfaces()) {
+    std::unique_ptr<egl::WindowSurface> hdr_surface =
+        manager->CreateHdrWindowSurface(GetWindowHandle(), width, height);
+    if (hdr_surface) {
+      return hdr_surface;
+    }
+    FML_LOG(ERROR) << "HDR window surface creation failed; using 8-bit.";
+  }
+  return manager->CreateWindowSurface(GetWindowHandle(), width, height);
+}
+
+bool FlutterWindowsView::SetHdrOutput(bool enabled, float sdr_white_nits) {
+  if (enabled) {
+    egl::Manager* manager = engine_->egl_manager();
+    if (manager == nullptr || !manager->SupportsHdrSurfaces() ||
+        engine_->impeller_enabled() || !(sdr_white_nits > 0.0f)) {
+      enabled = false;
+      sdr_white_nits = 80.0f;
+      if (!hdr_output_requested()) {
+        return false;
+      }
+      // Fall through: turn a previously enabled HDR output off.
+    }
+  }
+  sdr_white_nits_.store(enabled ? sdr_white_nits : 80.0f,
+                        std::memory_order_release);
+  const bool was_enabled =
+      hdr_output_requested_.exchange(enabled, std::memory_order_acq_rel);
+  if (was_enabled != enabled) {
+    // Backing stores are cached by size; make the next frame allocate them
+    // in the new format (see GetEmbedderRenderTargetFormatGeneration).
+    BumpEmbedderRenderTargetFormatGeneration();
+    FML_LOG(IMPORTANT) << "HDR output " << (enabled ? "on" : "off")
+                       << " (SDR white " << sdr_white_nits << " nits)";
+  }
+  engine_->ScheduleFrame();
+  return enabled;
+}
+
+bool FlutterWindowsView::EnsureSurfaceFormat() {
+  if (surface_ == nullptr || !surface_->IsValid()) {
+    return true;
+  }
+  egl::Manager* manager = engine_->egl_manager();
+  const bool want_hdr = hdr_output_requested() && manager != nullptr &&
+                        manager->SupportsHdrSurfaces();
+  if (surface_->is_hdr() == want_hdr) {
+    return true;
+  }
+
+  std::unique_lock<std::mutex> lock(resize_mutex_);
+  const size_t width = surface_->width();
+  const size_t height = surface_->height();
+  auto const existing_vsync = surface_->vsync_enabled();
+  if (!surface_->Destroy()) {
+    FML_LOG(ERROR) << "Output format switch failed to destroy surface";
+    return false;
+  }
+  std::unique_ptr<egl::WindowSurface> new_surface =
+      CreateWindowSurfaceForOutput(width, height);
+  if (!new_surface) {
+    FML_LOG(ERROR) << "Output format switch failed to create surface";
+    return false;
+  }
+  if (!new_surface->MakeCurrent() ||
+      !new_surface->SetVSyncEnabled(existing_vsync)) {
+    FML_LOG(ERROR) << "Output format switch failed to set vsync";
+  }
+  surface_ = std::move(new_surface);
+  FML_LOG(IMPORTANT) << "HDR output: window surface "
+                     << (surface_->is_hdr() ? "RGBA16F scRGB" : "8-bit");
+  return true;
+}

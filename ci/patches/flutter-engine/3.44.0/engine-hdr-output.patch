+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef FLUTTER_SHELL_PLATFORM_EMBEDDER_EMBEDDER_RENDER_TARGET_FORMAT_GENERATION_H_
+#define FLUTTER_SHELL_PLATFORM_EMBEDDER_EMBEDDER_RENDER_TARGET_FORMAT_GENERATION_H_
+
+#include <cstdint>
+
+namespace flutter {
+
+//------------------------------------------------------------------------------
+/// @brief      Fushi patch (HDR output): process-wide generation of the format
+///             embedders allocate backing stores with.
+///
+///             Render targets are cached by surface size alone and reused for
+///             as long as the size stays the same, so an embedder that starts
+///             allocating a different format (e.g. RGBA16F for HDR output)
+///             would otherwise never see its new format used. Each render
+///             target records the generation it was created under; the cache
+///             never hands out a target from an older generation. An embedder
+///             bumps the generation whenever its backing store format changes;
+///             stale targets are then collected on the next frame.
+///
+///             Free of Skia includes so platform embedders can use it.
+///             Defined in embedder_render_target.cc.
+///
+uint64_t GetEmbedderRenderTargetFormatGeneration();
+void BumpEmbedderRenderTargetFormatGeneration();
+
+}  // namespace flutter
+
+#endif  // FLUTTER_SHELL_PLATFORM_EMBEDDER_EMBEDDER_RENDER_TARGET_FORMAT_GENERATION_H_

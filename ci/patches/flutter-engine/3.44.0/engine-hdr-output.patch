+void CompositorOpenGL::ProbeBackingStore(uint32_t framebuffer_id,
+                                         size_t width,
+                                         size_t height) {
+  GLint previous = 0;
+  gl_->GetIntegerv(GL_FRAMEBUFFER_BINDING, &previous);
+  gl_->BindFramebuffer(GL_FRAMEBUFFER, framebuffer_id);
+  const GLint y = static_cast<GLint>(height / 2);
+  for (size_t i = 1; i < 4; i++) {
+    const GLint x = static_cast<GLint>(width * i / 4);
+    GLfloat p[4] = {};
+    gl_->ReadPixels(x, y, 1, 1, GL_RGBA, GL_FLOAT, p);
+    FML_LOG(IMPORTANT) << "HDR probe backing store (" << x << "," << y
+                       << ") = " << p[0] << " " << p[1] << " " << p[2] << " "
+                       << p[3];
+  }
+  gl_->BindFramebuffer(GL_FRAMEBUFFER, previous);
+}
+
+bool CompositorOpenGL::InitializeOutputProgram() {
+  if (output_program_ != 0) {
+    return true;
+  }
+  auto compile = [this](GLenum type, const char* source) -> GLuint {
+    GLuint shader = gl_->CreateShader(type);
+    gl_->ShaderSource(shader, 1, &source, nullptr);
+    gl_->CompileShader(shader);
+    GLint ok = GL_FALSE;
+    gl_->GetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+    if (ok != GL_TRUE) {
+      FML_LOG(ERROR) << "HDR output shader failed to compile.";
+      gl_->DeleteShader(shader);
+      return 0;
+    }
+    return shader;
+  };
+  GLuint vertex = compile(GL_VERTEX_SHADER, kOutputVertexShader);
+  GLuint fragment = compile(GL_FRAGMENT_SHADER, kOutputFragmentShader);
+  if (vertex == 0 || fragment == 0) {
+    if (vertex != 0) {
+      gl_->DeleteShader(vertex);
+    }
+    if (fragment != 0) {
+      gl_->DeleteShader(fragment);
+    }
+    return false;
+  }
+  GLuint program = gl_->CreateProgram();
+  gl_->AttachShader(program, vertex);
+  gl_->AttachShader(program, fragment);
+  gl_->BindAttribLocation(program, 0, "a_position");
+  gl_->LinkProgram(program);
+  gl_->DeleteShader(vertex);
+  gl_->DeleteShader(fragment);
+  GLint linked = GL_FALSE;
+  gl_->GetProgramiv(program, GL_LINK_STATUS, &linked);
+  if (linked != GL_TRUE) {
+    FML_LOG(ERROR) << "HDR output program failed to link.";
+    gl_->DeleteProgram(program);
+    return false;
+  }
+  static const GLfloat kQuad[] = {-1.0f, -1.0f, 1.0f, -1.0f,
+                                  -1.0f, 1.0f,  1.0f, 1.0f};
+  GLuint buffer = 0;
+  gl_->GenBuffers(1, &buffer);
+  gl_->BindBuffer(GL_ARRAY_BUFFER, buffer);
+  gl_->BufferData(GL_ARRAY_BUFFER, sizeof(kQuad), kQuad, GL_STATIC_DRAW);
+  output_vertex_buffer_ = buffer;
+  output_program_ = program;
+  output_texture_location_ = gl_->GetUniformLocation(program, "u_texture");
+  output_scale_location_ = gl_->GetUniformLocation(program, "u_scale");
+  output_decode_location_ = gl_->GetUniformLocation(program, "u_decode");
+  return true;
+}
+
+bool CompositorOpenGL::DrawToSurface(uint32_t texture_id,
+                                     int width,
+                                     int height,
+                                     bool decode,
+                                     float sdr_white_nits) {
+  const GLfloat scale = sdr_white_nits / kScRgbReferenceNits;
+  const GLfloat decode_flag = decode ? 1.0f : 0.0f;
+
+  // Skia does not re-validate its cached GL bindings between frames; restore
+  // everything this pass changes (see ScopedOutputPassState). Constructed
+  // before the lazy program/buffer setup, which binds the array buffer too.
+  ScopedOutputPassState saved(*gl_, resolver_, half_float_sized_format_);
+  if (!saved.attrib_saved()) {
+    FML_LOG(ERROR) << "HDR output: cannot query vertex attribute state.";
+    return false;
+  }
+  if (!InitializeOutputProgram()) {
+    return false;
+  }
+  gl_->BindFramebuffer(GL_FRAMEBUFFER, kWindowFrameBufferId);
+  gl_->Viewport(0, 0, width, height);
+  gl_->Disable(GL_SCISSOR_TEST);
+  gl_->Disable(GL_BLEND);
+  gl_->Disable(GL_DEPTH_TEST);
+  gl_->Disable(GL_STENCIL_TEST);
+  gl_->Disable(GL_CULL_FACE);
+  gl_->UseProgram(output_program_);
+  gl_->ActiveTexture(GL_TEXTURE0);
+  gl_->BindTexture(GL_TEXTURE_2D, texture_id);
+  gl_->Uniform1i(output_texture_location_, 0);
+  gl_->Uniform1fv(output_scale_location_, 1, &scale);
+  gl_->Uniform1fv(output_decode_location_, 1, &decode_flag);
+  gl_->BindBuffer(GL_ARRAY_BUFFER, output_vertex_buffer_);
+  gl_->EnableVertexAttribArray(0);
+  gl_->VertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 0, nullptr);
+  gl_->DrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+  return true;
+}

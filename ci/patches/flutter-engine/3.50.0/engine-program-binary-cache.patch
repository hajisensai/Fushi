+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/shell/platform/windows/egl/program_binary_cache.h"
+
+#include <windows.h>
+
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <vector>
+
+#include "gtest/gtest.h"
+
+namespace flutter {
+namespace egl {
+namespace testing {
+
+namespace {
+
+constexpr wchar_t kTag[] = L"0123456789abcdef";
+
+class ProgramBinaryCacheTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    wchar_t temp[MAX_PATH];
+    ASSERT_GT(::GetTempPathW(MAX_PATH, temp), 0u);
+    root_ = std::filesystem::path(temp) /
+            (L"flutter_program_binary_cache_" +
+             std::to_wstring(::GetCurrentProcessId()) + L"_" +
+             std::to_wstring(::GetTickCount64()));
+    std::error_code ec;
+    std::filesystem::remove_all(root_, ec);
+  }
+
+  void TearDown() override {
+    std::error_code ec;
+    std::filesystem::remove_all(root_, ec);
+  }
+
+  std::unique_ptr<ProgramBinaryCache> Open(
+      ProgramBinaryCache::Limits limits = ProgramBinaryCache::Limits()) {
+    auto cache =
+        std::make_unique<ProgramBinaryCache>(root_.wstring(), kTag, limits);
+    cache->WaitForIdle();
+    return cache;
+  }
+
+  static std::vector<uint8_t> Key(uint8_t seed) {
+    std::vector<uint8_t> key(20);
+    for (size_t i = 0; i < key.size(); ++i) {
+      key[i] = static_cast<uint8_t>(seed * 31 + i);
+    }
+    return key;
+  }
+
+  static std::vector<uint8_t> Value(uint8_t seed, size_t size) {
+    std::vector<uint8_t> value(size);
+    for (size_t i = 0; i < size; ++i) {
+      value[i] = static_cast<uint8_t>(seed + i * 7);
+    }
+    return value;
+  }
+
+  // The two-step EGL_ANDROID_blob_cache read ANGLE performs.
+  static std::vector<uint8_t> Read(ProgramBinaryCache& cache,
+                                   const std::vector<uint8_t>& key) {
+    const int64_t size = cache.Get(key.data(), key.size(), nullptr, 0);
+    if (size <= 0) {
+      return {};
+    }
+    std::vector<uint8_t> value(static_cast<size_t>(size));
+    EXPECT_EQ(cache.Get(key.data(), key.size(), value.data(), size), size);
+    return value;
+  }
+
+  std::vector<std::filesystem::path> BlobFiles() {
+    std::vector<std::filesystem::path> files;
+    std::error_code ec;
+    for (const auto& entry :
+         std::filesystem::directory_iterator(root_ / kTag, ec)) {
+      if (entry.path().extension() == L".bin") {
+        files.push_back(entry.path());
+      }
+    }
+    return files;
+  }
+
+  std::filesystem::path root_;
+};
+
+}  // namespace
+
+TEST_F(ProgramBinaryCacheTest, RoundTripsAcrossInstances) {
+  const auto key = Key(1);
+  const auto value = Value(1, 5000);
+  {
+    auto cache = Open();
+    EXPECT_TRUE(Read(*cache, key).empty());
+    cache->Put(key.data(), key.size(), value.data(), value.size());
+    // Visible before the background write lands.
+    EXPECT_EQ(Read(*cache, key), value);
+    cache->WaitForIdle();
+    EXPECT_EQ(cache->GetStats().stored, 1u);
+  }
+  auto cache = Open();
+  EXPECT_EQ(Read(*cache, key), value);
+  EXPECT_EQ(cache->GetStats().hits, 1u);
+  EXPECT_EQ(Read(*cache, Key(2)).size(), 0u);
+}
+
+TEST_F(ProgramBinaryCacheTest, SmallBufferOnlyReportsSize) {
+  const auto key = Key(3);
+  const auto value = Value(3, 100);
+  auto cache = Open();
+  cache->Put(key.data(), key.size(), value.data(), value.size());
+  cache->WaitForIdle();
+  std::vector<uint8_t> small(10, 0xee);
+  EXPECT_EQ(cache->Get(key.data(), key.size(), small.data(), small.size()),
+            100);
+  EXPECT_EQ(small, std::vector<uint8_t>(10, 0xee));
+}
+
+TEST_F(ProgramBinaryCacheTest, DamagedFilesAreMissesAndRemoved) {
+  const auto truncated_key = Key(4);
+  const auto flipped_key = Key(5);
+  {
+    auto cache = Open();
+    const auto value = Value(4, 3000);
+    cache->Put(truncated_key.data(), truncated_key.size(), value.data(),
+               value.size());
+    cache->Put(flipped_key.data(), flipped_key.size(), value.data(),
+               value.size());
+    cache->WaitForIdle();
+  }
+  auto files = BlobFiles();
+  ASSERT_EQ(files.size(), 2u);
+  for (const auto& file : files) {
+    const bool truncate =
+        file.filename().wstring().find(L"7c7d7e") != std::wstring::npos;
+    if (truncate) {
+      std::filesystem::resize_file(file, 1000);
+    } else {
+      std::fstream stream(file,
+                          std::ios::in | std::ios::out | std::ios::binary);
+      stream.seekp(-1, std::ios::end);
+      stream.put(static_cast<char>(0x5a));
+    }
+  }
+  {
+    auto cache = Open();
+    EXPECT_TRUE(Read(*cache, truncated_key).empty());
+    EXPECT_TRUE(Read(*cache, flipped_key).empty());
+    cache->WaitForIdle();
+    EXPECT_EQ(cache->GetStats().corrupt, 2u);
+  }
+  EXPECT_TRUE(BlobFiles().empty());
+}
+
+TEST_F(ProgramBinaryCacheTest, FileForAnotherKeyIsAMiss) {
+  const auto key = Key(6);
+  const auto other = Key(7);
+  {
+    auto cache = Open();
+    const auto value = Value(6, 64);
+    cache->Put(key.data(), key.size(), value.data(), value.size());
+    cache->WaitForIdle();
+  }
+  auto files = BlobFiles();
+  ASSERT_EQ(files.size(), 1u);
+  // Same bytes under the other key's file name.
+  {
+    auto cache = Open();
+    cache->Put(other.data(), other.size(), Value(7, 64).data(), 64);
+    cache->WaitForIdle();
+  }
+  files = BlobFiles();
+  ASSERT_EQ(files.size(), 2u);
+  std::filesystem::copy_file(files[0], files[1],
+                             std::filesystem::copy_options::overwrite_existing);
+  auto cache = Open();
+  const auto first = Read(*cache, key);
+  const auto second = Read(*cache, other);
+  // Exactly one of the two names now holds bytes for the wrong key.
+  EXPECT_NE(first.empty(), second.empty());
+}
+
+TEST_F(ProgramBinaryCacheTest, EvictsLeastRecentlyUsedToTheCap) {
+  ProgramBinaryCache::Limits limits;
+  limits.max_total_bytes = 10 * 1024;
+  auto cache = Open(limits);
+  for (uint8_t i = 0; i < 10; ++i) {
+    const auto key = Key(10 + i);
+    const auto value = Value(i, 2000);
+    cache->Put(key.data(), key.size(), value.data(), value.size());
+    cache->WaitForIdle();
+    ::Sleep(20);  // Distinct write times.
+  }
+  uint64_t total = 0;
+  for (const auto& file : BlobFiles()) {
+    total += std::filesystem::file_size(file);
+  }
+  EXPECT_LE(total, limits.max_total_bytes);
+  EXPECT_GT(cache->GetStats().evicted, 0u);
+  // The newest entry survives, the oldest does not.
+  EXPECT_FALSE(Read(*cache, Key(19)).empty());
+  EXPECT_TRUE(Read(*cache, Key(10)).empty());
+}
+
+TEST_F(ProgramBinaryCacheTest, OversizedEntriesAreNotStored) {
+  ProgramBinaryCache::Limits limits;
+  limits.max_entry_bytes = 1000;
+  auto cache = Open(limits);
+  const auto key = Key(30);
+  const auto value = Value(30, 1001);
+  cache->Put(key.data(), key.size(), value.data(), value.size());
+  cache->WaitForIdle();
+  EXPECT_EQ(cache->GetStats().dropped, 1u);
+  EXPECT_TRUE(BlobFiles().empty());
+}
+
+TEST_F(ProgramBinaryCacheTest, DeletesOtherNamespacesOnly) {
+  std::filesystem::create_directories(root_ / L"fedcba9876543210");
+  std::filesystem::create_directories(root_ / L"keep-me");
+  std::ofstream(root_ / L"fedcba9876543210" / L"x.bin") << "stale";
+  auto cache = Open();
+  EXPECT_FALSE(std::filesystem::exists(root_ / L"fedcba9876543210"));
+  EXPECT_TRUE(std::filesystem::exists(root_ / L"keep-me"));
+  EXPECT_TRUE(std::filesystem::is_directory(root_ / kTag));
+}
+
+TEST_F(ProgramBinaryCacheTest, UnusableDirectoryFallsBackToMisses) {
+  // The root is a file: the namespace folder cannot be created.
+  std::filesystem::create_directories(root_.parent_path());
+  std::ofstream(root_) << "not a directory";
+  auto cache = Open();
+  const auto key = Key(40);
+  const auto value = Value(40, 128);
+  cache->Put(key.data(), key.size(), value.data(), value.size());
+  cache->WaitForIdle();
+  EXPECT_TRUE(Read(*cache, key).empty());
+  EXPECT_EQ(cache->GetStats().stored, 0u);
+  std::error_code ec;
+  std::filesystem::remove(root_, ec);
+}
+
+TEST_F(ProgramBinaryCacheTest, RejectsBadArguments) {
+  auto cache = Open();
+  const auto value = Value(50, 16);
+  cache->Put(nullptr, 20, value.data(), value.size());
+  cache->Put(Key(50).data(), 0, value.data(), value.size());
+  cache->Put(Key(50).data(), 20, nullptr, 16);
+  EXPECT_EQ(cache->Get(nullptr, 20, nullptr, 0), 0);
+  cache->WaitForIdle();
+  EXPECT_TRUE(BlobFiles().empty());
+}
+
+TEST(ProgramBinaryCacheNamespaceTest, TagIsAStableNamespaceFolderName) {
+  const std::wstring tag = ProgramBinaryCache::CurrentNamespaceTag();
+  EXPECT_TRUE(ProgramBinaryCache::IsNamespaceFolderName(tag));
+  EXPECT_EQ(tag, ProgramBinaryCache::CurrentNamespaceTag());
+  EXPECT_FALSE(ProgramBinaryCache::IsNamespaceFolderName(L"0123456789ABCDEF"));
+  EXPECT_FALSE(ProgramBinaryCache::IsNamespaceFolderName(L"keep-me"));
+}

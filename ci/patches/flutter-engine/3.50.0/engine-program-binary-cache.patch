+namespace flutter {
+namespace egl {
+
+namespace {
+
+// Bump when the file layout or the namespace recipe changes, and whenever a
+// Fushi ANGLE patch changes what ANGLE writes into program binaries without
+// changing the engine version (the namespace then changes with the module
+// file anyway, but this documents the contract).
+constexpr char kNamespaceRecipe[] = "fushi-program-binary-cache/1";
+
+constexpr uint32_t kMagic = 0x42505346;  // "FSPB" little-endian.
+constexpr uint32_t kFormat = 1;
+constexpr size_t kHeaderSize = 32;
+constexpr size_t kMaxKeyBytes = 1024;
+constexpr size_t kMaxSizedValues = 8;
+// Temp files of a crashed writer are removed once they are this old (a live
+// writer in another process renames its temp file within milliseconds).
+constexpr uint64_t kStaleTempAge100ns = 10ull * 60 * 10'000'000;
+
+constexpr uint64_t kFnvOffset = 0xcbf29ce484222325ull;
+constexpr uint64_t kFnvPrime = 0x100000001b3ull;
+
+uint64_t Fnv1a(uint64_t hash, const uint8_t* data, size_t size) {
+  for (size_t i = 0; i < size; ++i) {
+    hash ^= data[i];
+    hash *= kFnvPrime;
+  }
+  return hash;
+}
+
+void PutU32(uint8_t* out, uint32_t v) {
+  for (int i = 0; i < 4; ++i) {
+    out[i] = static_cast<uint8_t>(v >> (8 * i));
+  }
+}
+
+void PutU64(uint8_t* out, uint64_t v) {
+  for (int i = 0; i < 8; ++i) {
+    out[i] = static_cast<uint8_t>(v >> (8 * i));
+  }
+}
+
+uint32_t GetU32(const uint8_t* in) {
+  uint32_t v = 0;
+  for (int i = 0; i < 4; ++i) {
+    v |= static_cast<uint32_t>(in[i]) << (8 * i);
+  }
+  return v;
+}
+
+uint64_t GetU64(const uint8_t* in) {
+  uint64_t v = 0;
+  for (int i = 0; i < 8; ++i) {
+    v |= static_cast<uint64_t>(in[i]) << (8 * i);
+  }
+  return v;
+}
+
+std::wstring Hex(const uint8_t* data, size_t size) {
+  static const wchar_t kDigits[] = L"0123456789abcdef";
+  std::wstring out;
+  out.reserve(size * 2);
+  for (size_t i = 0; i < size; ++i) {
+    out.push_back(kDigits[data[i] >> 4]);
+    out.push_back(kDigits[data[i] & 0xf]);
+  }
+  return out;
+}
+
+std::wstring Hex64(uint64_t v) {
+  uint8_t bytes[8];
+  for (int i = 0; i < 8; ++i) {
+    bytes[i] = static_cast<uint8_t>(v >> (8 * (7 - i)));
+  }
+  return Hex(bytes, sizeof(bytes));
+}
+
+bool EndsWith(const std::wstring& s, const wchar_t* suffix) {
+  const size_t n = wcslen(suffix);
+  return s.size() >= n && s.compare(s.size() - n, n, suffix) == 0;
+}
+
+uint64_t FileTimeToU64(const FILETIME& t) {
+  return (static_cast<uint64_t>(t.dwHighDateTime) << 32) | t.dwLowDateTime;
+}
+
+uint64_t NowAsFileTime() {
+  FILETIME now;
+  ::GetSystemTimeAsFileTime(&now);
+  return FileTimeToU64(now);
+}
+
+bool IsFatalWriteError(DWORD error) {
+  switch (error) {
+    case ERROR_DISK_FULL:
+    case ERROR_HANDLE_DISK_FULL:
+    case ERROR_ACCESS_DENIED:
+    case ERROR_PATH_NOT_FOUND:
+    case ERROR_WRITE_PROTECT:
+    case ERROR_NOT_READY:
+      return true;
+    default:
+      return false;
+  }
+}
+
+// Optional diagnostics: FUSHI_PROGRAM_CACHE_LOG=<file> appends one line per
+// idle transition of the background thread.
+void AppendDiagnosticLine(const std::string& line) {
+  wchar_t path[MAX_PATH];
+  const DWORD n =
+      ::GetEnvironmentVariableW(L"FUSHI_PROGRAM_CACHE_LOG", path, MAX_PATH);
+  if (n == 0 || n >= MAX_PATH) {
+    return;
+  }
+  HANDLE file =
+      ::CreateFileW(path, FILE_APPEND_DATA, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                    nullptr, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+  if (file == INVALID_HANDLE_VALUE) {
+    return;
+  }
+  DWORD written = 0;
+  ::WriteFile(file, line.data(), static_cast<DWORD>(line.size()), &written,
+              nullptr);
+  ::CloseHandle(file);
+}
+
+std::mutex& GlobalMutex() {
+  static std::mutex* mutex = new std::mutex();
+  return *mutex;
+}
+
+ProgramBinaryCache*& GlobalInstance() {
+  static ProgramBinaryCache* instance = nullptr;
+  return instance;
+}
+
+}  // namespace
+
+ProgramBinaryCache::ProgramBinaryCache(std::wstring root,
+                                       std::wstring namespace_tag,
+                                       Limits limits)
+    : root_(std::move(root)),
+      namespace_tag_(std::move(namespace_tag)),
+      directory_(root_ + L"\\" + namespace_tag_),
+      limits_(limits) {
+  // The background thread starts with maintenance (directory creation,
+  // stale-namespace cleanup, size cap); |WaitForIdle| waits for it too.
+  busy_ = true;
+  worker_ = std::thread([this]() { WorkerMain(); });
+}
+
+ProgramBinaryCache::~ProgramBinaryCache() {
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    shutting_down_ = true;
+  }
+  work_available_.notify_all();
+  if (worker_.joinable()) {
+    worker_.join();
+  }
+}
+
+// static
+std::wstring ProgramBinaryCache::CurrentNamespaceTag() {
+  std::string recipe = kNamespaceRecipe;
+  recipe += "|";
+  recipe += GetFlutterEngineVersion();
+  // The module file identifies the exact build: two engine builds from the
+  // same commit with different patches differ in size and timestamp.
+  HMODULE module = nullptr;
+  wchar_t path[MAX_PATH];
+  WIN32_FILE_ATTRIBUTE_DATA attributes = {};
+  if (::GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                               GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                           reinterpret_cast<LPCWSTR>(&Fnv1a), &module)) {
+    const DWORD n = ::GetModuleFileNameW(module, path, MAX_PATH);
+    if (n > 0 && n < MAX_PATH &&
+        ::GetFileAttributesExW(path, GetFileExInfoStandard, &attributes)) {
+      char buffer[64];
+      std::snprintf(buffer, sizeof(buffer), "|%lu.%lu|%llu",
+                    attributes.nFileSizeHigh, attributes.nFileSizeLow,
+                    static_cast<unsigned long long>(
+                        FileTimeToU64(attributes.ftLastWriteTime)));
+      recipe += buffer;
+    }
+  }
+  const uint64_t hash =
+      Fnv1a(kFnvOffset, reinterpret_cast<const uint8_t*>(recipe.data()),
+            recipe.size());
+  return Hex64(hash);
+}
+
+// static
+bool ProgramBinaryCache::IsNamespaceFolderName(const std::wstring& name) {
+  if (name.size() != 16) {
+    return false;
+  }
+  return std::all_of(name.begin(), name.end(), [](wchar_t c) {
+    return (c >= L'0' && c <= L'9') || (c >= L'a' && c <= L'f');
+  });
+}
+
+// static
+std::wstring ProgramBinaryCache::FileNameForKey(const uint8_t* key,
+                                                size_t key_size) {
+  if (key_size <= 64) {
+    return Hex(key, key_size) + L".bin";
+  }
+  // The full key is stored in the file and compared on read.
+  return L"h" + Hex64(Fnv1a(kFnvOffset, key, key_size)) + L".bin";
+}
+
+// static
+std::vector<uint8_t> ProgramBinaryCache::Encode(const uint8_t* key,
+                                                size_t key_size,
+                                                const uint8_t* value,
+                                                size_t value_size) {
+  std::vector<uint8_t> file(kHeaderSize + key_size + value_size);
+  uint8_t* header = file.data();
+  PutU32(header, kMagic);
+  PutU32(header + 4, kFormat);
+  PutU32(header + 8, static_cast<uint32_t>(key_size));
+  PutU32(header + 12, 0);
+  PutU64(header + 16, value_size);
+  PutU64(header + 24,
+         Fnv1a(Fnv1a(kFnvOffset, key, key_size), value, value_size));
+  std::memcpy(file.data() + kHeaderSize, key, key_size);
+  std::memcpy(file.data() + kHeaderSize + key_size, value, value_size);
+  return file;
+}
+
+// static
+bool ProgramBinaryCache::Decode(const std::vector<uint8_t>& file,
+                                const uint8_t* key,
+                                size_t key_size,
+                                std::vector<uint8_t>* value) {
+  if (file.size() < kHeaderSize) {
+    return false;
+  }
+  const uint8_t* header = file.data();
+  if (GetU32(header) != kMagic || GetU32(header + 4) != kFormat ||
+      GetU32(header + 8) != key_size) {
+    return false;
+  }
+  const uint64_t value_size = GetU64(header + 16);
+  if (file.size() - kHeaderSize < key_size || value_size == 0 ||
+      value_size != file.size() - kHeaderSize - key_size) {
+    return false;
+  }
+  const uint8_t* stored_key = file.data() + kHeaderSize;
+  const uint8_t* stored_value = stored_key + key_size;
+  if (std::memcmp(stored_key, key, key_size) != 0) {
+    return false;
+  }
+  if (GetU64(header + 24) != Fnv1a(Fnv1a(kFnvOffset, stored_key, key_size),
+                                   stored_value, value_size)) {
+    return false;
+  }
+  value->assign(stored_value, stored_value + value_size);
+  return true;
+}
+
+bool ProgramBinaryCache::ReadEntry(
+    const std::wstring& file_name,
+    const uint8_t* key,
+    size_t key_size,
+    std::shared_ptr<const std::vector<uint8_t>>* value) {
+  const std::wstring path = directory_ + L"\\" + file_name;
+  // FILE_SHARE_DELETE: the writer (this or another process) may replace or
+  // evict the file while it is being read; this handle keeps its old bytes.
+  HANDLE file =
+      ::CreateFileW(path.c_str(), GENERIC_READ,
+                    FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                    nullptr, OPEN_EXISTING, FILE_FLAG_SEQUENTIAL_SCAN, nullptr);
+  if (file == INVALID_HANDLE_VALUE) {
+    return false;
+  }
+  bool ok = false;
+  bool corrupt = true;
+  LARGE_INTEGER size = {};
+  if (::GetFileSizeEx(file, &size) && size.QuadPart > 0 &&
+      static_cast<uint64_t>(size.QuadPart) <=
+          kHeaderSize + key_size + limits_.max_entry_bytes) {
+    std::vector<uint8_t> contents(static_cast<size_t>(size.QuadPart));
+    DWORD read = 0;
+    if (::ReadFile(file, contents.data(), static_cast<DWORD>(contents.size()),
+                   &read, nullptr) &&
+        read == contents.size()) {
+      auto decoded = std::make_shared<std::vector<uint8_t>>();
+      if (Decode(contents, key, key_size, decoded.get())) {
+        *value = std::move(decoded);
+        ok = true;
+        corrupt = false;
+      }
+    } else {
+      // A read error is not evidence of a bad file.
+      corrupt = false;
+    }
+  }
+  ::CloseHandle(file);
+  if (corrupt) {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      ++stats_.corrupt;
+    }
+    Enqueue({Task::Kind::kDelete, file_name, nullptr});
+  }
+  return ok;
+}
+
+int64_t ProgramBinaryCache::Get(const void* key,
+                                int64_t key_size,
+                                void* value,
+                                int64_t value_size) {
+  if (key == nullptr || key_size <= 0 ||
+      static_cast<uint64_t>(key_size) > kMaxKeyBytes || value_size < 0) {
+    return 0;
+  }
+  const auto* key_bytes = static_cast<const uint8_t*>(key);
+  const size_t key_length = static_cast<size_t>(key_size);
+  const std::wstring file_name = FileNameForKey(key_bytes, key_length);
+
+  std::shared_ptr<const std::vector<uint8_t>> found;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto sized = sized_values_.find(file_name);
+    if (sized != sized_values_.end()) {
+      found = sized->second;
+    } else {
+      auto pending = pending_values_.find(file_name);
+      if (pending != pending_values_.end()) {
+        auto decoded = std::make_shared<std::vector<uint8_t>>();
+        if (Decode(*pending->second, key_bytes, key_length, decoded.get())) {
+          found = std::move(decoded);
+        }
+      }
+    }
+  }
+  if (!found && !ReadEntry(file_name, key_bytes, key_length, &found)) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    ++stats_.misses;
+    return 0;
+  }
+
+  const int64_t size = static_cast<int64_t>(found->size());
+  bool copied = false;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (value != nullptr && value_size >= size) {
+      std::memcpy(value, found->data(), found->size());
+      sized_values_.erase(file_name);
+      ++stats_.hits;
+      copied = true;
+    } else {
+      if (sized_values_.size() >= kMaxSizedValues) {
+        sized_values_.clear();
+      }
+      sized_values_[file_name] = found;
+    }
+  }
+  if (copied) {
+    // Keeps recently used entries away from eviction.
+    Enqueue({Task::Kind::kTouch, file_name, nullptr});
+  }
+  return size;
+}
+
+void ProgramBinaryCache::Put(const void* key,
+                             int64_t key_size,
+                             const void* value,
+                             int64_t value_size) {
+  if (key == nullptr || key_size <= 0 ||
+      static_cast<uint64_t>(key_size) > kMaxKeyBytes || value == nullptr ||
+      value_size <= 0) {
+    return;
+  }
+  const auto* key_bytes = static_cast<const uint8_t*>(key);
+  const size_t key_length = static_cast<size_t>(key_size);
+  const std::wstring file_name = FileNameForKey(key_bytes, key_length);
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (writes_disabled_) {
+      return;
+    }
+    if (static_cast<uint64_t>(value_size) > limits_.max_entry_bytes ||
+        pending_bytes_ + kHeaderSize + key_length + value_size >
+            limits_.max_pending_bytes) {
+      ++stats_.dropped;
+      return;
+    }
+  }
+  auto contents = std::make_shared<const std::vector<uint8_t>>(
+      Encode(key_bytes, key_length, static_cast<const uint8_t*>(value),
+             static_cast<size_t>(value_size)));
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    pending_bytes_ += contents->size();
+    pending_values_[file_name] = contents;
+    // A size query may have cached an older value for this key.
+    sized_values_.erase(file_name);
+    tasks_.push_back({Task::Kind::kWrite, file_name, std::move(contents)});
+  }
+  work_available_.notify_one();
+}
+
+void ProgramBinaryCache::Enqueue(Task task) {
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (shutting_down_) {
+      return;
+    }
+    tasks_.push_back(std::move(task));
+  }
+  work_available_.notify_one();
+}
+
+void ProgramBinaryCache::WaitForIdle() {
+  std::unique_lock<std::mutex> lock(mutex_);
+  idle_.wait(lock, [this]() { return tasks_.empty() && !busy_; });
+}
+
+ProgramBinaryCache::Stats ProgramBinaryCache::GetStats() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  return stats_;
+}
+
+void ProgramBinaryCache::WorkerMain() {
+  // Background mode lowers both CPU and I/O priority: the cache must never
+  // compete with the launch it is trying to speed up.
+  ::SetThreadPriority(::GetCurrentThread(), THREAD_MODE_BACKGROUND_BEGIN);
+  Maintain();
+  bool did_work = true;
+  while (true) {
+    Task task;
+    {
+      std::unique_lock<std::mutex> lock(mutex_);
+      busy_ = false;
+      if (tasks_.empty()) {
+        idle_.notify_all();
+        if (did_work) {
+          char line[256];
+          std::snprintf(
+              line, sizeof(line),
+              "program binary cache idle: hits=%llu misses=%llu corrupt=%llu "
+              "stored=%llu dropped=%llu evicted=%llu writes_disabled=%d\n",
+              static_cast<unsigned long long>(stats_.hits),
+              static_cast<unsigned long long>(stats_.misses),
+              static_cast<unsigned long long>(stats_.corrupt),
+              static_cast<unsigned long long>(stats_.stored),
+              static_cast<unsigned long long>(stats_.dropped),
+              static_cast<unsigned long long>(stats_.evicted),
+              writes_disabled_ ? 1 : 0);
+          lock.unlock();
+          AppendDiagnosticLine(line);
+          lock.lock();
+          did_work = false;
+        }
+      }
+      work_available_.wait(
+          lock, [this]() { return shutting_down_ || !tasks_.empty(); });
+      if (shutting_down_) {
+        return;
+      }
+      task = std::move(tasks_.front());
+      tasks_.pop_front();
+      busy_ = true;
+    }
+    RunTask(task);
+    did_work = true;
+    if (task.kind == Task::Kind::kWrite) {
+      std::lock_guard<std::mutex> lock(mutex_);
+      pending_bytes_ -= task.contents->size();
+      auto pending = pending_values_.find(task.file_name);
+      if (pending != pending_values_.end() &&
+          pending->second == task.contents) {
+        pending_values_.erase(pending);
+      }
+    }
+  }
+}
+
+void ProgramBinaryCache::Maintain() {
+  std::error_code ec;
+  std::filesystem::create_directories(directory_, ec);
+  if (ec || !std::filesystem::is_directory(directory_, ec)) {
+    DisableWrites("cannot create the cache directory",
+                  static_cast<unsigned long>(ec.value()));
+    return;
+  }
+  directory_ready_ = true;
+
+  // Blobs of other engine builds can never be used again.
+  for (std::filesystem::directory_iterator it(root_, ec), end; !ec && it != end;
+       it.increment(ec)) {
+    const std::wstring name = it->path().filename().wstring();
+    std::error_code type_ec;
+    if (name != namespace_tag_ && IsNamespaceFolderName(name) &&
+        it->is_directory(type_ec)) {
+      std::error_code remove_ec;
+      std::filesystem::remove_all(it->path(), remove_ec);
+    }
+  }
+
+  const uint64_t now = NowAsFileTime();
+  WIN32_FIND_DATAW data;
+  HANDLE find = ::FindFirstFileW((directory_ + L"\\*").c_str(), &data);
+  if (find != INVALID_HANDLE_VALUE) {
+    do {
+      if (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) {
+        continue;
+      }
+      const std::wstring name = data.cFileName;
+      const uint64_t write_time = FileTimeToU64(data.ftLastWriteTime);
+      if (EndsWith(name, L".tmp")) {
+        if (now > write_time && now - write_time > kStaleTempAge100ns) {
+          ::DeleteFileW((directory_ + L"\\" + name).c_str());
+        }
+        continue;
+      }
+      if (!EndsWith(name, L".bin")) {
+        continue;
+      }
+      const uint64_t size =
+          (static_cast<uint64_t>(data.nFileSizeHigh) << 32) | data.nFileSizeLow;
+      files_[name] = {size, write_time};
+      total_bytes_ += size;
+    } while (::FindNextFileW(find, &data));
+    ::FindClose(find);
+  }
+  EvictToLimit();
+}
+
+void ProgramBinaryCache::RunTask(const Task& task) {
+  if (!directory_ready_) {
+    return;
+  }
+  const std::wstring path = directory_ + L"\\" + task.file_name;
+  switch (task.kind) {
+    case Task::Kind::kWrite: {
+      {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (writes_disabled_) {
+          return;
+        }
+      }
+      if (!WriteFileAtomically(task.file_name, *task.contents)) {
+        return;
+      }
+      auto previous = files_.find(task.file_name);
+      if (previous != files_.end()) {
+        total_bytes_ -= previous->second.size;
+      }
+      files_[task.file_name] = {task.contents->size(), NowAsFileTime()};
+      total_bytes_ += task.contents->size();
+      {
+        std::lock_guard<std::mutex> lock(mutex_);
+        ++stats_.stored;
+      }
+      EvictToLimit();
+      break;
+    }
+    case Task::Kind::kTouch: {
+      HANDLE file =
+          ::CreateFileW(path.c_str(), FILE_WRITE_ATTRIBUTES,
+                        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                        nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+      if (file == INVALID_HANDLE_VALUE) {
+        return;
+      }
+      FILETIME now;
+      ::GetSystemTimeAsFileTime(&now);
+      ::SetFileTime(file, nullptr, nullptr, &now);
+      ::CloseHandle(file);
+      auto entry = files_.find(task.file_name);
+      if (entry != files_.end()) {
+        entry->second.write_time = FileTimeToU64(now);
+      }
+      break;
+    }
+    case Task::Kind::kDelete: {
+      ::DeleteFileW(path.c_str());
+      auto entry = files_.find(task.file_name);
+      if (entry != files_.end()) {
+        total_bytes_ -= entry->second.size;
+        files_.erase(entry);
+      }
+      break;
+    }
+  }
+}
+
+bool ProgramBinaryCache::WriteFileAtomically(
+    const std::wstring& file_name,
+    const std::vector<uint8_t>& contents) {
+  const std::wstring path = directory_ + L"\\" + file_name;
+  const std::wstring temp =
+      path + L"." + std::to_wstring(::GetCurrentProcessId()) + L".tmp";
+  HANDLE file = ::CreateFileW(temp.c_str(), GENERIC_WRITE, 0, nullptr,
+                              CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+  if (file == INVALID_HANDLE_VALUE) {
+    const DWORD error = ::GetLastError();
+    if (IsFatalWriteError(error)) {
+      DisableWrites("cannot create a cache file", error);
+    }
+    return false;
+  }
+  DWORD written = 0;
+  const bool wrote =
+      ::WriteFile(file, contents.data(), static_cast<DWORD>(contents.size()),
+                  &written, nullptr) &&
+      written == contents.size();
+  const DWORD write_error = wrote ? ERROR_SUCCESS : ::GetLastError();
+  ::CloseHandle(file);
+  if (!wrote) {
+    ::DeleteFileW(temp.c_str());
+    if (IsFatalWriteError(write_error)) {
+      DisableWrites("cannot write a cache file", write_error);
+    }
+    return false;
+  }
+  // No FlushFileBuffers: a file torn by a power loss fails the checksum and
+  // is treated as a miss.
+  if (!::MoveFileExW(temp.c_str(), path.c_str(), MOVEFILE_REPLACE_EXISTING)) {
+    // E.g. another process holds the target without FILE_SHARE_DELETE; the
+    // entry is simply not cached this time.
+    ::DeleteFileW(temp.c_str());
+    return false;
+  }
+  return true;
+}
+
+void ProgramBinaryCache::EvictToLimit() {
+  if (total_bytes_ <= limits_.max_total_bytes) {
+    return;
+  }
+  std::vector<std::pair<uint64_t, std::wstring>> by_age;
+  by_age.reserve(files_.size());
+  for (const auto& [name, info] : files_) {
+    by_age.emplace_back(info.write_time, name);
+  }
+  std::sort(by_age.begin(), by_age.end());
+  uint64_t evicted = 0;
+  for (const auto& [write_time, name] : by_age) {
+    if (total_bytes_ <= limits_.max_total_bytes) {
+      break;
+    }
+    ::DeleteFileW((directory_ + L"\\" + name).c_str());
+    auto entry = files_.find(name);
+    total_bytes_ -= entry->second.size;
+    files_.erase(entry);
+    ++evicted;
+  }
+  std::lock_guard<std::mutex> lock(mutex_);
+  stats_.evicted += evicted;
+}
+
+void ProgramBinaryCache::DisableWrites(const char* reason,
+                                       unsigned long error) {
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (writes_disabled_) {
+      return;
+    }
+    writes_disabled_ = true;
+  }
+  FML_LOG(WARNING) << "Program binary cache: " << reason << " (error " << error
+                   << "); shaders compile as usual this session.";
+}
+
+// static
+bool ProgramBinaryCache::InstallGlobal(const std::wstring& root) {
+  std::lock_guard<std::mutex> lock(GlobalMutex());
+  ProgramBinaryCache*& instance = GlobalInstance();
+  if (instance != nullptr) {
+    return instance->root_ == root;
+  }
+  // Process lifetime (never destroyed): ANGLE may call the callbacks until
+  // the process exits. Queued writes that have not landed by then are lost,
+  // which only costs a compile on the next launch.
+  instance = new ProgramBinaryCache(root, CurrentNamespaceTag(), Limits());
+  FML_LOG(IMPORTANT) << "Program binary cache: "
+                     << fml::WideStringToUtf8(instance->directory_);
+  return true;
+}
+
+// static
+ProgramBinaryCache* ProgramBinaryCache::Global() {
+  std::lock_guard<std::mutex> lock(GlobalMutex());
+  return GlobalInstance();
+}
+
+// static
+void ProgramBinaryCache::SetBlobCallback(const void* key,
+                                         int64_t key_size,
+                                         const void* value,
+                                         int64_t value_size) {
+  if (ProgramBinaryCache* cache = Global()) {
+    cache->Put(key, key_size, value, value_size);
+  }
+}
+
+// static
+int64_t ProgramBinaryCache::GetBlobCallback(const void* key,
+                                            int64_t key_size,
+                                            void* value,
+                                            int64_t value_size) {
+  ProgramBinaryCache* cache = Global();
+  return cache != nullptr ? cache->Get(key, key_size, value, value_size) : 0;
+}
+
+}  // namespace egl
+}  // namespace flutter

+#ifndef FLUTTER_SHELL_PLATFORM_WINDOWS_EGL_PROGRAM_BINARY_CACHE_H_
+#define FLUTTER_SHELL_PLATFORM_WINDOWS_EGL_PROGRAM_BINARY_CACHE_H_
+
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "flutter/fml/macros.h"
+
+namespace flutter {
+namespace egl {
+
+// Fushi patch (program binary disk cache): a persistent backing store for
+// ANGLE's EGL_ANDROID_blob_cache.
+//
+// ANGLE (D3D11 backend) serializes every linked program -- including the
+// D3D bytecode it produced with d3dcompiler -- into its blob cache, keyed by a
+// SHA-1 over the shader sources, ANGLE's program/translator versions, the
+// GL_RENDERER string (adapter + driver version) and the pre-link program
+// state. Without application callbacks that cache only lives in memory, so
+// Impeller's ContentContext recompiles every pipeline on every launch. This
+// class gives the callbacks a directory:
+//
+// - One file per key under <root>\<namespace>\. The namespace folds in this
+//   engine build's identity (engine version, cache format, the module file's
+//   size and timestamp), so a different engine never sees another engine's
+//   blobs; stale namespace folders are deleted in the background.
+// - Every file carries a header (magic, format, sizes, FNV-1a checksum over
+//   key and value). A file that is short, corrupt or for another key is a
+//   miss (and gets deleted): ANGLE then links from source as usual.
+// - |Get| reads synchronously (that is the point: the read replaces a
+//   compile on the same thread); |Put| only copies the blob into a queue. A
+//   low-priority background thread does all writes (temp file + atomic
+//   rename), mtime refreshes on hits, deletions and the size-cap eviction
+//   (least recently written/used first).
+// - Any I/O failure degrades to "not cached". A directory that cannot be
+//   created or written, or a full disk, turns writes off for the session.
+class ProgramBinaryCache {
+ public:
+  struct Limits {
+    // Upper bound for all blob files in the namespace folder.
+    uint64_t max_total_bytes = 32ull * 1024 * 1024;
+    // Larger blobs are not stored.
+    uint64_t max_entry_bytes = 4ull * 1024 * 1024;
+    // Upper bound for blobs queued but not yet written.
+    uint64_t max_pending_bytes = 16ull * 1024 * 1024;
+  };
+
+  struct Stats {
+    uint64_t hits = 0;
+    uint64_t misses = 0;
+    uint64_t corrupt = 0;
+    uint64_t stored = 0;
+    uint64_t dropped = 0;
+    uint64_t evicted = 0;
+  };
+
+  // |root| must be an absolute path. |namespace_tag| names the subfolder the
+  // blobs live in; blobs under any other subfolder of |root| that looks like
+  // a namespace (see |IsNamespaceFolderName|) are deleted.
+  ProgramBinaryCache(std::wstring root,
+                     std::wstring namespace_tag,
+                     Limits limits);
+  ~ProgramBinaryCache();
+
+  // EGL_ANDROID_blob_cache semantics: returns the size of the value stored
+  // for |key| (0 when there is none). The value is copied into |value| only
+  // when |value_size| is large enough.
+  int64_t Get(const void* key,
+              int64_t key_size,
+              void* value,
+              int64_t value_size);
+
+  // Queues |value| for |key|. Never blocks on I/O.
+  void Put(const void* key,
+           int64_t key_size,
+           const void* value,
+           int64_t value_size);
+
+  // Blocks until the background thread has nothing left to do. Tests only.
+  void WaitForIdle();
+
+  Stats GetStats();
+
+  const std::wstring& directory() const { return directory_; }
+
+  // The namespace for the running engine module.
+  static std::wstring CurrentNamespaceTag();
+
+  static bool IsNamespaceFolderName(const std::wstring& name);
+
+  // Process-wide instance used by the EGL callbacks. Returns false when a
+  // cache is already installed for a different root (the first one wins:
+  // ANGLE's display keeps its callbacks for its whole lifetime).
+  static bool InstallGlobal(const std::wstring& root);
+  static ProgramBinaryCache* Global();
+
+  // EGLSetBlobFuncANDROID / EGLGetBlobFuncANDROID for |Global()|.
+  static void SetBlobCallback(const void* key,
+                              int64_t key_size,
+                              const void* value,
+                              int64_t value_size);
+  static int64_t GetBlobCallback(const void* key,
+                                 int64_t key_size,
+                                 void* value,
+                                 int64_t value_size);
+
+ private:
+  struct Task {
+    enum class Kind { kWrite, kTouch, kDelete } kind;
+    std::wstring file_name;
+    std::shared_ptr<const std::vector<uint8_t>> contents;
+  };
+
+  struct FileInfo {
+    uint64_t size = 0;
+    uint64_t write_time = 0;
+  };
+
+  static std::wstring FileNameForKey(const uint8_t* key, size_t key_size);
+  static std::vector<uint8_t> Encode(const uint8_t* key,
+                                     size_t key_size,
+                                     const uint8_t* value,
+                                     size_t value_size);
+  // Returns the value bytes when |file| is a valid entry for |key|.
+  static bool Decode(const std::vector<uint8_t>& file,
+                     const uint8_t* key,
+                     size_t key_size,
+                     std::vector<uint8_t>* value);
+
+  bool ReadEntry(const std::wstring& file_name,
+                 const uint8_t* key,
+                 size_t key_size,
+                 std::shared_ptr<const std::vector<uint8_t>>* value);
+  void Enqueue(Task task);
+  void WorkerMain();
+  void Maintain();
+  void RunTask(const Task& task);
+  bool WriteFileAtomically(const std::wstring& file_name,
+                           const std::vector<uint8_t>& contents);
+  void EvictToLimit();
+  void DisableWrites(const char* reason, unsigned long error);
+
+  const std::wstring root_;
+  const std::wstring namespace_tag_;
+  const std::wstring directory_;
+  const Limits limits_;
+
+  std::mutex mutex_;
+  std::condition_variable work_available_;
+  std::condition_variable idle_;
+  std::deque<Task> tasks_;
+  bool busy_ = false;
+  bool shutting_down_ = false;
+  bool writes_disabled_ = false;
+  uint64_t pending_bytes_ = 0;
+  // Values queued for writing (lookups must see them before they land).
+  std::map<std::wstring, std::shared_ptr<const std::vector<uint8_t>>>
+      pending_values_;
+  // Values read by a size query and not yet copied out: ANGLE asks for the
+  // size first and then for the bytes, and the file must not be read twice.
+  std::map<std::wstring, std::shared_ptr<const std::vector<uint8_t>>>
+      sized_values_;
+  Stats stats_;
+
+  // Background thread only.
+  std::map<std::wstring, FileInfo> files_;
+  uint64_t total_bytes_ = 0;
+  bool directory_ready_ = false;
+
+  std::thread worker_;
+
+  FML_DISALLOW_COPY_AND_ASSIGN(ProgramBinaryCache);
+};
+
+}  // namespace egl
+}  // namespace flutter
+
+#endif  // FLUTTER_SHELL_PLATFORM_WINDOWS_EGL_PROGRAM_BINARY_CACHE_H_

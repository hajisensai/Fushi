+// Before any frame has been presented (e.g. the framework defers its first
+// frame) a window resize has nothing to synchronize with: it must not block
+// the platform thread, and the first frame must still land on a surface of the
+// new size.
+TEST(FlutterWindowsViewTest, WindowResizeBeforeFirstFrameDoesNotBlock) {
+  auto windows_proc_table = std::make_shared<NiceMock<MockWindowsProcTable>>();
+  std::unique_ptr<FlutterWindowsEngine> engine =
+      GetTestEngine(windows_proc_table);
+
+  EngineModifier engine_modifier{engine.get()};
+  engine_modifier.embedder_api().PostRenderThreadTask = MOCK_ENGINE_PROC(
+      PostRenderThreadTask,
+      ([](auto engine, VoidCallback callback, void* user_data) {
+        callback(user_data);
+        return kSuccess;
+      }));
+
+  auto egl_manager = std::make_unique<egl::MockManager>();
+  auto surface = std::make_unique<egl::MockWindowSurface>();
+  auto resized_surface = std::make_unique<egl::MockWindowSurface>();
+  auto resized_surface_ptr = resized_surface.get();
+
+  EXPECT_CALL(*surface.get(), IsValid).WillRepeatedly(Return(true));
+  EXPECT_CALL(*surface.get(), Destroy).WillOnce(Return(true));
+
+  // The only surface created is the one of the new size.
+  EXPECT_CALL(*egl_manager.get(),
+              CreateWindowSurface(_, /*width=*/500, /*height=*/300))
+      .WillOnce(Return(std::move((resized_surface))));
+  EXPECT_CALL(*resized_surface_ptr, IsValid).WillRepeatedly(Return(true));
+  EXPECT_CALL(*resized_surface_ptr, MakeCurrent).WillOnce(Return(true));
+  EXPECT_CALL(*resized_surface_ptr, SetVSyncEnabled).WillOnce(Return(true));
+  EXPECT_CALL(*windows_proc_table.get(), DwmFlush).WillOnce(Return(S_OK));
+  EXPECT_CALL(*resized_surface_ptr, Destroy).WillOnce(Return(true));
+
+  int metrics_sent = 0;
+  engine_modifier.embedder_api().SendWindowMetricsEvent = MOCK_ENGINE_PROC(
+      SendWindowMetricsEvent,
+      ([&metrics_sent](auto engine, const FlutterWindowMetricsEvent* event) {
+        metrics_sent++;
+        return kSuccess;
+      }));
+
+  std::unique_ptr<FlutterWindowsView> view =
+      engine->CreateView(std::make_unique<NiceMock<MockWindowBindingHandler>>(),
+                         /*is_sized_to_content=*/false, BoxConstraints(),
+                         /*allow_implicit_view=*/true);
+
+  ViewModifier view_modifier{view.get()};
+  engine_modifier.SetEGLManager(std::move(egl_manager));
+  view_modifier.SetSurface(std::move(surface));
+  metrics_sent = 0;
+
+  // No raster thread produces a frame. The resize returns right away (well
+  // under the 100 ms synchronization timeout) after sending the metrics.
+  auto start = std::chrono::steady_clock::now();
+  EXPECT_FALSE(view->OnWindowSizeChanged(500, 300));
+  auto elapsed = std::chrono::steady_clock::now() - start;
+  EXPECT_LT(elapsed, std::chrono::milliseconds(50));
+  EXPECT_EQ(metrics_sent, 1);
+
+  // A second size change before the first frame (e.g. a maximize after a
+  // setBounds) does not block either; the latest size wins.
+  start = std::chrono::steady_clock::now();
+  EXPECT_FALSE(view->OnWindowSizeChanged(400, 200));
+  EXPECT_FALSE(view->OnWindowSizeChanged(500, 300));
+  elapsed = std::chrono::steady_clock::now() - start;
+  EXPECT_LT(elapsed, std::chrono::milliseconds(50));
+
+  // The resize is still pending: a stale frame of another size is rejected
+  // instead of being drawn on the old surface...
+  EXPECT_FALSE(view->OnFrameGenerated(400, 200));
+
+  // ...and the first frame of the new size resizes the surface on the raster
+  // thread before it is presented, completing the resize.
+  EXPECT_TRUE(view->OnFrameGenerated(500, 300));
+  view->OnFramePresented();
+  EXPECT_EQ(view->surface(), resized_surface_ptr);
+}
+
+// Once a frame has been presented, a window resize keeps synchronizing with
+// the next frame exactly as before: with no frame coming it waits for the
+// full timeout.
+TEST(FlutterWindowsViewTest, WindowResizeAfterFirstFrameStillBlocks) {
+  std::unique_ptr<FlutterWindowsEngine> engine = GetTestEngine();
+
+  EngineModifier engine_modifier(engine.get());
+  engine_modifier.embedder_api().PostRenderThreadTask = MOCK_ENGINE_PROC(
+      PostRenderThreadTask,
+      ([](auto engine, VoidCallback callback, void* user_data) {
+        callback(user_data);
+        return kSuccess;
+      }));
+
+  auto egl_manager = std::make_unique<egl::MockManager>();
+  auto surface = std::make_unique<egl::MockWindowSurface>();
+
+  EXPECT_CALL(*surface.get(), IsValid).WillRepeatedly(Return(true));
+  EXPECT_CALL(*surface.get(), Destroy).WillOnce(Return(true));
+
+  std::unique_ptr<FlutterWindowsView> view =
+      engine->CreateView(std::make_unique<NiceMock<MockWindowBindingHandler>>(),
+                         /*is_sized_to_content=*/false, BoxConstraints(),
+                         /*allow_implicit_view=*/true);
+
+  ViewModifier view_modifier{view.get()};
+  engine_modifier.SetEGLManager(std::move(egl_manager));
+  view_modifier.SetSurface(std::move(surface));
+
+  view->OnFramePresented();
+
+  auto start = std::chrono::steady_clock::now();
+  EXPECT_FALSE(view->OnWindowSizeChanged(500, 500));
+  auto elapsed = std::chrono::steady_clock::now() - start;
+  EXPECT_GE(elapsed, std::chrono::milliseconds(100));
+}

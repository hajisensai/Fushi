# Copy to .env (git-ignored) and edit. Never bake keys into the image.

# Owner of the files in the config volume (run `id` on the host).
PUID=1000
PGID=1000
TZ=Etc/UTC
FUSHI_DEVICE_NAME=Fushi Server

# Host paths.
FUSHI_CONFIG_DIR=./config
FUSHI_MEDIA_DIR=./media

# Which release the image packages (Dockerfile build args).
# FUSHI_SERVER_REPO=samutw/fushi-server
# FUSHI_SERVER_TAG=v0.1.0-beta.23883

# Optional API keys. FUSHI_* variables take precedence over keys stored in the
# server; leave unset to manage them in the WebUI instead.
# FUSHI_OPENSUBTITLES_API_KEY=
# FUSHI_OPENSUBTITLES_USERNAME=
# FUSHI_OPENSUBTITLES_PASSWORD=
# FUSHI_SUBDL_API_KEY=
# FUSHI_JIMAKU_API_KEY=
# FUSHI_ANIDB_USERNAME=
# FUSHI_ANIDB_PASSWORD=
# FUSHI_BANGUMI_TOKEN=
# FUSHI_PLEX_TOKEN=

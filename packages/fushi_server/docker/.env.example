# Copy to .env (git-ignored) and edit. Never bake keys into the image.

# The container runs as this user and group (run `id -u` / `id -g` on the host).
# The config folder must be writable by it; media folders readable.
PUID=1000
PGID=1000
TZ=Etc/UTC
FUSHI_DEVICE_NAME=Fushi Server

# Language of the WebUI, CLI and logs on the FIRST start: en or zh. Afterwards
# change it in WebUI Settings (this value is not applied again).
FUSHI_LANGUAGE=en

# Host ports (pair with <host>:FUSHI_SYNC_PORT).
# FUSHI_SYNC_PORT=38765
# FUSHI_WEBUI_PORT=38780
# FUSHI_TORRENT_PORT=6881

# Host paths.
FUSHI_CONFIG_DIR=./config
FUSHI_MEDIA_DIR=./media

# Source build (docker-compose.yml): commit recorded in fushi-anki-sync's AGPL
# source notice. Optional for images you only run yourself.
# FUSHI_SOURCE_COMMIT=

# Release-bundle build (docker-compose.bundle.yml): which release to package.
# FUSHI_SERVER_REPO=hajisensai/fushi-server
# FUSHI_SERVER_TAG=v0.1.0-beta.14880

# Optional API keys. FUSHI_* variables take precedence over keys stored in the
# server; leave unset to manage them in the WebUI instead.
# FUSHI_OPENSUBTITLES_API_KEY=
# FUSHI_OPENSUBTITLES_USERNAME=
# FUSHI_OPENSUBTITLES_PASSWORD=
# FUSHI_SUBDL_API_KEY=
# FUSHI_JIMAKU_API_KEY=
# FUSHI_ANIDB_USERNAME=
# FUSHI_ANIDB_PASSWORD=
# FUSHI_BANGUMI_TOKEN=
# FUSHI_PLEX_TOKEN=

# Image name. Defaults: fushi-server:source (docker-compose.yml) and
# fushi-server:bundle (docker-compose.bundle.yml). Set it to run a prebuilt
# image, e.g. ghcr.io/hajisensai/fushi-server:latest once one is published,
# and start with `docker compose up -d` (no --build).
# FUSHI_IMAGE=

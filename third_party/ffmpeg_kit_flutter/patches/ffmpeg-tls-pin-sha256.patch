 #include "tls.h"
 #include "libavutil/avstring.h"
 #include "libavutil/getenv_utf8.h"
+#include "libavutil/mem.h"
 #include "libavutil/opt.h"
 #include "libavutil/parseutils.h"
+#include "libavutil/sha.h"
+
+/* Hibiki: certificate fingerprint pinning shared by all TLS backends. Mirrors
+ * the app's TOFU pinning (SHA-256 over the leaf certificate DER); see
+ * hibiki_tls_identity.dart fingerprintOf(). Backend code calls this after the
+ * handshake with the peer leaf certificate; a match authoritatively accepts the
+ * connection without CA/hostname checks (self-signed LAN hosts), a mismatch
+ * fails the handshake. */
+int ff_tls_check_cert_pin(void *logctx, const uint8_t *der_cert, int der_len,
+                          const char *pin)
+{
+    static const char hexdig[] = "0123456789abcdef";
+    struct AVSHA *sha;
+    uint8_t digest[32];
+    char have[65];
+    char want[65];
+    int i, j;
+
+    if (!pin || !*pin)
+        return 0;
+    if (!der_cert || der_len <= 0) {
+        av_log(logctx, AV_LOG_ERROR,
+               "tls_pin_sha256: no peer certificate to pin against\n");
+        return AVERROR(EIO);
+    }
+
+    /* Normalise the expected pin: drop ':'/whitespace, lowercase, expect 64 hex. */
+    for (i = 0, j = 0; pin[i] && j < 64; i++) {
+        char ch = pin[i];
+        if (ch == ':' || ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r')
+            continue;
+        if (ch >= 'A' && ch <= 'F')
+            ch = ch - 'A' + 'a';
+        if (!((ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f'))) {
+            av_log(logctx, AV_LOG_ERROR,
+                   "tls_pin_sha256: non-hex character in pin\n");
+            return AVERROR(EINVAL);
+        }
+        want[j++] = ch;
+    }
+    want[j] = '\0';
+    if (j != 64 || pin[i]) {
+        av_log(logctx, AV_LOG_ERROR,
+               "tls_pin_sha256: expected 64 hex digits (SHA-256)\n");
+        return AVERROR(EINVAL);
+    }
+
+    sha = av_sha_alloc();
+    if (!sha)
+        return AVERROR(ENOMEM);
+    av_sha_init(sha, 256);
+    av_sha_update(sha, der_cert, der_len);
+    av_sha_final(sha, digest);
+    av_free(sha);
+
+    for (i = 0; i < 32; i++) {
+        have[i * 2]     = hexdig[digest[i] >> 4];
+        have[i * 2 + 1] = hexdig[digest[i] & 0x0f];
+    }
+    have[64] = '\0';
+
+    if (memcmp(have, want, 64)) {
+        av_log(logctx, AV_LOG_ERROR,
+               "tls_pin_sha256: peer certificate fingerprint %s does not match pin\n",
+               have);
+        return AVERROR(EIO);
+    }
+    av_log(logctx, AV_LOG_VERBOSE,
+           "tls_pin_sha256: peer certificate fingerprint verified\n");
+    return 0;
+}
 

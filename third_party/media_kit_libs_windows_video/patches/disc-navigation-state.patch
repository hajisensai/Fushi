+static const char *dvd_domain_label(enum stream_dvd_domain domain)
+{
+    switch (domain) {
+    case STREAM_DVD_DOMAIN_FP:   return "FP";
+    case STREAM_DVD_DOMAIN_VMGM: return "VMGM";
+    case STREAM_DVD_DOMAIN_VTSM: return "VTSM";
+    case STREAM_DVD_DOMAIN_VTS:  return "VTS";
+    default:                     return "unknown";
+    }
+}
+
+// The DVD branch: VM position, still state and the live button highlight
+// (rectangle in source pixels, the four select-state colours as 0xAARRGGBB).
+static void add_dvd_navigation_state(struct mpv_node *dst,
+                                     const struct stream_nav_state *st)
+{
+    struct mpv_node *dvd = node_map_add(dst, "dvd-state", MPV_FORMAT_NODE_MAP);
+    node_map_add_string(dvd, "domain", dvd_domain_label(st->dvd.domain));
+    node_map_add_int64(dvd, "vts", st->dvd.vts);
+    node_map_add_int64(dvd, "title", st->dvd.title);
+    node_map_add_int64(dvd, "part", st->dvd.part);
+    node_map_add_int64(dvd, "pgc", st->dvd.pgcn);
+    node_map_add_int64(dvd, "pg", st->dvd.pgn);
+    node_map_add_int64(dvd, "cell", st->dvd.celln);
+    node_map_add_flag(dvd, "still", st->still_active);
+    node_map_add_int64(dvd, "button", st->dvd.button);
+    node_map_add_int64(dvd, "button-count", st->dvd.num_buttons);
+    node_map_add_flag(dvd, "title-menu-allowed", st->dvd.title_menu_allowed);
+    node_map_add_flag(dvd, "root-menu-allowed", st->dvd.root_menu_allowed);
+    if (st->dvd.button > 0 && mp_rect_w(st->hl.rect) > 0 &&
+        mp_rect_h(st->hl.rect) > 0)
+    {
+        struct mpv_node *hl = node_map_add(dvd, "highlight", MPV_FORMAT_NODE_MAP);
+        node_map_add_int64(hl, "x0", st->hl.rect.x0);
+        node_map_add_int64(hl, "y0", st->hl.rect.y0);
+        node_map_add_int64(hl, "x1", st->hl.rect.x1);
+        node_map_add_int64(hl, "y1", st->hl.rect.y1);
+        struct mpv_node *palette = node_map_add(hl, "palette", MPV_FORMAT_NODE_ARRAY);
+        for (int i = 0; i < 4; i++)
+            node_array_add(palette, MPV_FORMAT_INT64)->u.int64 = st->hl.palette[i];
+    }
+}
+
+// Fushi v2: one native snapshot, never infer MPLS / DVD title from display
+// labels. v2 adds "disc-type" and the "dvd-state" branch; the Blu-ray fields
+// are unchanged from v1.
+static int mp_property_disc_navigation_state(void *ctx, struct m_property *prop,
+                                             int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    struct stream *s = disc_nav_get_stream(mpctx);
+    struct stream_nav_state st = {0};
+    if (!s || stream_control(s, STREAM_CTRL_GET_NAV_STATE, &st) < 1 ||
+        !(st.bluray_state || st.dvd_state))
+        return M_PROPERTY_UNAVAILABLE;
+    double position = get_current_time(mpctx);
+    // A DVD title has no playlist; its identity is domain + title + PGC.
+    bool identity = st.dvd_state || st.disc_playlist >= 0;
+    struct m_sub_property props[] = {
+        {"version", SUB_PROP_INT(2)},
+        {"disc-type", SUB_PROP_STR(st.dvd_state ? "dvd" : "bluray")},
+        {"nav-active", SUB_PROP_BOOL(st.nav_active)},
+        {"menu-active", SUB_PROP_BOOL(st.menu_active)},
+        {"menu-domain", SUB_PROP_BOOL(st.menu_domain)},
+        {"menu-call-allowed", SUB_PROP_BOOL(st.menu_call_allowed)},
+        {"title", SUB_PROP_INT(st.disc_title)},
+        {"playlist", SUB_PROP_INT(st.disc_playlist)},
+        {"generation", SUB_PROP_INT64(st.generation)},
+        {"angle", SUB_PROP_INT(st.angle > 0 ? st.angle - 1 : -1)},
+        {"position", SUB_PROP_DOUBLE(position)},
+        {"stable", SUB_PROP_BOOL(!st.drain_pending && disc_nav_generation_ready(mpctx, st.generation) && identity && position >= 0)},
+        {"bdj-detected", SUB_PROP_BOOL(st.bdj_detected)},
+        {"bdj-handled", SUB_PROP_BOOL(st.bdj_handled)},
+        {"src-width", SUB_PROP_INT(st.src_w)},
+        {"src-height", SUB_PROP_INT(st.src_h)},
+        {0}
+    };
+    int r = m_property_read_sub(props, action, arg);
+    if (r == M_PROPERTY_OK && action == M_PROPERTY_GET && st.dvd_state)
+        add_dvd_navigation_state(arg, &st);
+    return r;
+}
+
+// media_kit's public getProperty uses MPV_FORMAT_STRING. Keep its wire
+// format explicit instead of depending on generic node-to-string printing.
+static int mp_property_disc_navigation_state_json(void *ctx, struct m_property *prop,
+                                                  int action, void *arg)
+{
+    if (action == M_PROPERTY_GET_TYPE)
+        return m_property_strdup_ro(action, arg, "");
+    struct mpv_node node = {0};
+    int r = mp_property_disc_navigation_state(ctx, prop, M_PROPERTY_GET, &node);
+    if (r != M_PROPERTY_OK)
+        return r;
+    char *json = NULL;
+    if (json_write(&json, &node) < 0) {
+        talloc_free(node.u.list);
+        talloc_free(json);
+        return M_PROPERTY_ERROR;
+    }
+    r = m_property_strdup_ro(action, arg, json);
+    talloc_free(node.u.list);
+    talloc_free(json);
+    return r;
+}

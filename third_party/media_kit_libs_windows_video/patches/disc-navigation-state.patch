+// Fushi v1: one native snapshot, never infer MPLS from display labels.
+static int mp_property_disc_navigation_state(void *ctx, struct m_property *prop,
+                                             int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    struct stream *s = disc_nav_get_stream(mpctx);
+    struct stream_nav_state st = {0};
+    if (!s || stream_control(s, STREAM_CTRL_GET_NAV_STATE, &st) < 1 || !st.bluray_state)
+        return M_PROPERTY_UNAVAILABLE;
+    double position = get_current_time(mpctx);
+    struct m_sub_property props[] = {
+        {"version", SUB_PROP_INT(1)},
+        {"nav-active", SUB_PROP_BOOL(st.nav_active)},
+        {"menu-active", SUB_PROP_BOOL(st.menu_active)},
+        {"menu-domain", SUB_PROP_BOOL(st.menu_domain)},
+        {"menu-call-allowed", SUB_PROP_BOOL(st.menu_call_allowed)},
+        {"title", SUB_PROP_INT(st.disc_title)},
+        {"playlist", SUB_PROP_INT(st.disc_playlist)},
+        {"generation", SUB_PROP_INT64(st.generation)},
+        {"angle", SUB_PROP_INT(st.angle > 0 ? st.angle - 1 : -1)},
+        {"position", SUB_PROP_DOUBLE(position)},
+        {"stable", SUB_PROP_BOOL(!st.drain_pending && disc_nav_generation_ready(mpctx, st.generation) && st.disc_playlist >= 0 && position >= 0)},
+        {"bdj-detected", SUB_PROP_BOOL(st.bdj_detected)},
+        {"bdj-handled", SUB_PROP_BOOL(st.bdj_handled)},
+        {"src-width", SUB_PROP_INT(st.src_w)},
+        {"src-height", SUB_PROP_INT(st.src_h)},
+        {0}
+    };
+    return m_property_read_sub(props, action, arg);
+}
+
+// media_kit's public getProperty uses MPV_FORMAT_STRING. Keep its wire
+// format explicit instead of depending on generic node-to-string printing.
+static int mp_property_disc_navigation_state_json(void *ctx, struct m_property *prop,
+                                                  int action, void *arg)
+{
+    if (action == M_PROPERTY_GET_TYPE)
+        return m_property_strdup_ro(action, arg, "");
+    struct mpv_node node = {0};
+    int r = mp_property_disc_navigation_state(ctx, prop, M_PROPERTY_GET, &node);
+    if (r != M_PROPERTY_OK)
+        return r;
+    char *json = NULL;
+    if (json_write(&json, &node) < 0) {
+        talloc_free(node.u.list);
+        talloc_free(json);
+        return M_PROPERTY_ERROR;
+    }
+    r = m_property_strdup_ro(action, arg, json);
+    talloc_free(node.u.list);
+    talloc_free(json);
+    return r;
+}

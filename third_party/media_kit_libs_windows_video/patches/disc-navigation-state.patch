+static enum stream_dvd_domain dvd_domain(dvdnav_t *dvdnav)
+{
+    if (dvdnav_is_domain_fp(dvdnav) == 1)
+        return STREAM_DVD_DOMAIN_FP;
+    if (dvdnav_is_domain_vmgm(dvdnav) == 1)
+        return STREAM_DVD_DOMAIN_VMGM;
+    if (dvdnav_is_domain_vtsm(dvdnav) == 1)
+        return STREAM_DVD_DOMAIN_VTSM;
+    if (dvdnav_is_domain_vts(dvdnav) == 1)
+        return STREAM_DVD_DOMAIN_VTS;
+    return STREAM_DVD_DOMAIN_UNKNOWN;
+}
+
+// Re-read the title identity from the VM. A different domain, title or PGC is
+// a new generation; a new program or cell inside the same PGC is not (chapter
+// changes within one title keep its progress, subtitles and study binding).
+// Runs with priv->lock held.
+static void refresh_title_identity(struct priv *priv)
+{
+    int32_t title = 0, part = 0, pgcn = 0, pgn = 0;
+    // FP and a VM without a loaded VTS legitimately fail; that is "no title".
+    if (dvdnav_current_title_program(priv->dvdnav, &title, &pgcn, &pgn) !=
+        DVDNAV_STATUS_OK)
+        title = pgcn = pgn = 0;
+    if (title > 0 && dvdnav_current_title_info(priv->dvdnav, &title, &part) !=
+        DVDNAV_STATUS_OK)
+        part = 0;
+    enum stream_dvd_domain domain = dvd_domain(priv->dvdnav);
+    if (!priv->identity_seen || domain != priv->id_domain ||
+        title != priv->id_title || pgcn != priv->id_pgcn)
+    {
+        priv->generation++;
+        priv->nav_change_id++;
+    } else if (part != priv->id_part || pgn != priv->id_pgn) {
+        priv->nav_change_id++;
+    }
+    priv->identity_seen = true;
+    priv->id_domain = domain;
+    priv->id_title = title;
+    priv->id_part = title > 0 ? part : 0;
+    priv->id_pgcn = pgcn;
+    priv->id_pgn = pgn;
+}

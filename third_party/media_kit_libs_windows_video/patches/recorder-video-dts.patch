+// Derive a DTS for a video packet that has only a PTS. Matroska stores no DTS,
+// so demux_mkv delivers every packet like this. Left to libavformat, the DTS is
+// guessed only if video_delay is set (add_stream() skips that whenever the
+// demuxer attached lav_codecpar, which demux_mkv now does for all video), its
+// reorder buffer is seeded with the first packet's PTS (so the leading pictures
+// of an open GOP get a DTS going backwards), and the guessing is deprecated.
+// Each rejected packet is lost from the output. Use the same buffer, seeded
+// with the segment start, which is not above any PTS of the segment.
+static double guess_dts(struct mp_recorder_sink *rst, double pts)
+{
+    double *buf = rst->dts_buf;
+    if (!rst->dts_seeded) {
+        MP_DBG(rst->owner, "Deriving missing DTS of stream %d from PTS.\n",
+               rst->av_stream->index);
+        for (int i = 1; i <= QUEUE_MIN_PACKETS; i++)
+            buf[i] = rst->owner->rebase_ts;
+        rst->dts_seeded = true;
+    }
+    buf[0] = pts;
+    for (int i = 0; i < QUEUE_MIN_PACKETS && buf[i] > buf[i + 1]; i++)
+        MPSWAP(double, buf[i], buf[i + 1]);
+    return buf[0];
+}

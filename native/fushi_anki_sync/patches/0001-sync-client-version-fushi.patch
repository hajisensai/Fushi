index 29f8403..413bc41 100644
--- a/rslib/src/version.rs
+++ b/rslib/src/version.rs
@@ -12,12 +12,23 @@ pub fn buildhash() -> &'static str {
     option_env!("BUILDHASH").unwrap_or("dev").trim()

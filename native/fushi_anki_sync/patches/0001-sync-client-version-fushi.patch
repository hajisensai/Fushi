+/// Version of the Fushi helper that links this library (set at build time).
+fn fushi_version() -> &'static str {
+    option_env!("FUSHI_ANKI_SYNC_VERSION").unwrap_or("dev").trim()
+}
+
+/// The client identity sent to sync servers, exposed so the Fushi helper can report it.
+pub fn fushi_sync_client_version() -> &'static str {
+    sync_client_version()
+}
+
 pub(crate) fn sync_client_version() -> &'static str {
     static VER: LazyLock<String> = LazyLock::new(|| {
         format!(
-            "anki,{version} ({buildhash}),{platform}",
+            // Fushi: identify honestly as a third-party client, not as official Anki.
+            "fushi,{fushi} (anki {version}),{platform}",
+            fushi = fushi_version(),
             version = version(),
-            buildhash = buildhash(),
             platform = env::var("PLATFORM").unwrap_or_else(|_| env::consts::OS.to_string())
         )
     });

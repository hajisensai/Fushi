      "build": {
        "windows": "build_windows_dll.ps1",
        "linux": "build_linux_so.sh",
        "macos": "build_macos_dylib.sh",
        "android": "build_android_so.sh"
      },
      "platforms": {
        "windows": { "artifact": "fushi_compute.dll", "required": "always", "bundled_by": "app" },
        "linux": { "artifact": "libfushi_compute.so", "required": "always", "bundled_by": "app" },
        "macos": { "artifact": "libfushi_compute.dylib", "required": "always", "bundled_by": "app" },

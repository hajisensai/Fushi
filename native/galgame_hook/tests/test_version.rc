// 本目录所有 *_test 可执行文件共用的 VERSIONINFO 资源（由 CMakeLists.txt 末尾统一挂上）。
//
// 为什么需要：不带任何版本资源的极小 x64 Release 控制台 exe 会撞杀软的泛型启发式。
// 实测本机 Kaspersky 把 fushi_utterance_window_test.exe 报为 VHO:Trojan.Win32.Sdum.gen，
// 落盘后数秒内锁定并删除，CTest 因此在 x64 少跑一条（BUG-1708 验证记录里那条 32/33）。
// 同一份源码只多这一段 VERSIONINFO，重复构建两次都不再被拦，测试正常执行通过。
// 守卫：tests/test_version_resource_test.cpp（读自身模块的版本资源，缺了即红）。
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Fushi"
      VALUE "FileDescription", "Fushi galgame hook unit test"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "ProductName", "Fushi galgame hook tests"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

{
  "$comment": [
    "Hand-maintained input of fushi/tool/native_licenses.dart (run: cd fushi && dart run tool/native_licenses.dart).",
    "rust: target triples each native/<crate>/Cargo.lock ships for, plus optional prepare steps; every native/*/Cargo.lock is discovered automatically.",
    "cxx: C/C++ libraries without package-manager metadata. texts point at the vendored original, or at a verbatim upstream copy in native/third_party_licenses/texts/.",
    "spdx/: SPDX standard texts, used only for crates that ship no license file."
  ],
  "rust": {
    "defaultTargets": [
      "x86_64-pc-windows-msvc",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-linux-android",
      "armv7-linux-androideabi",
      "x86_64-linux-android",
      "aarch64-apple-ios",
      "aarch64-apple-ios-sim",
      "x86_64-apple-ios"
    ],
    "crates": {
      "fushi_anki_sync": {
        "targets": [
          "x86_64-pc-windows-msvc",
          "aarch64-apple-darwin",
          "x86_64-unknown-linux-gnu"
        ],
        "prepare": {
          "ifMissing": ".anki-src",
          "command": [
            "git",
            "clone",
            "--depth",
            "1",
            "--branch",
            "26.09.3",
            "https://github.com/ankitects/anki",
            ".anki-src"
          ]
        }
      },
      "fushi_ios_umbrella": {
        "targets": [
          "aarch64-apple-ios",
          "aarch64-apple-ios-sim",
          "x86_64-apple-ios"
        ]
      }
    }
  },

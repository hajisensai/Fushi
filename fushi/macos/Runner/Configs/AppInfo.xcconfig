// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = fushi

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = app.fushi.reader

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Fushi. All rights reserved.

// Native fushidicts FFI library, built by the macOS Runner target and copied
// into Contents/Frameworks so DynamicLibrary.open can resolve it from the app.
FUSHIDICTS_SOURCE_DIR = $(PROJECT_DIR)/../../native/fushidicts
FUSHIDICTS_BUILD_DIR = $(PROJECT_DIR)/Flutter/ephemeral/fushidicts/$(CONFIGURATION)
FUSHIDICTS_DYLIB_NAME = libfushidicts_ffi.dylib

// 主屏 / 通知中心小组件与主 app 共用的 App Group（macOS 组名要带 Team ID 前缀；本地 /
// ad-hoc 构建前缀为空）。CI 的 Developer ID 重签按 APPLE_TEAM_ID 展开，见
// tool/apple/macos_widgets_sign.sh。运行时以签进去的值为准（FushiAppGroup.identifier）。
FUSHI_APP_GROUP = $(TeamIdentifierPrefix)app.fushi.reader

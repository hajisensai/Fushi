<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#9BCAF8</color>
    <color name="ic_launcher_full_background">#FFFFFF</color>
    <!-- 默认档「白色圆角方形（squircle）」背景：不透明白，任意壁纸下可见（TODO-1241）。 -->
    <color name="ic_launcher_squircle_background">#FFFFFF</color>
    <!-- 「简约（wordmark）」备选档背景：不透明白（TODO-1269 回归修复）。
         自适应图标（adaptive-icon）背景层不能用纯透明 #00000000——Android 会把它
         合成到不透明底层上，多数启动器渲染成纯黑，导致老用户升级后图标背景全黑
         （原 TODO-1241 想做「透明无背景」，但自适应图标物理上无法透明）。因此这里必须
         是不透明色；沿用回归前的白，任意壁纸下可见、绝不发黑。 -->
    <color name="ic_launcher_minimal_background">#FFFFFF</color>
</resources>

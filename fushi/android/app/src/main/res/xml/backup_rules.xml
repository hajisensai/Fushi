<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 自动备份规则（API ≤ 30；API 31+ 走 data_extraction_rules.xml，两份必须同步）。
  只有 exclude、没有 include：其余文件照旧备份，只排除下面这些。

  排行榜账户文件 <support>/leaderboard/profile_<id>.json 里是设备私钥（等同密码），
  不得随系统备份上云 / 迁到新设备。<support> 在 Android 上是
  getApplicationSupportDirectory() = Context.getFilesDir()，即 domain="file" 的根。
  见 fushi/lib/src/leaderboard/leaderboard_store.dart。
-->
<full-backup-content>
    <exclude domain="file" path="leaderboard/" />
</full-backup-content>

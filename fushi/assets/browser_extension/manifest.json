{
  "manifest_version": 3,
  "name": "Fushi Reader Bridge",
  "version": "0.1.0",
  "description": "Look up words on web pages using Fushi's dictionaries.",
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "permissions": ["storage", "activeTab", "tabCapture", "offscreen", "scripting", "alarms", "sidePanel", "cookies"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["frame-capture.js", "bridge-shim.js", "subtitle-adapters.js", "popup-size.js", "locales/en.js", "i18n.js", "material-color.js", "theme-palette.js", "theme.js", "icons.js", "subtitle-style.js", "vendor/dict-media.js", "vendor/selection.js", "vendor/popup.js", "auto-read.js", "ruby-render.js", "scan.js", "subtitle-providers.js", "nested-popup-host.js", "mine-outcome.js", "video-target.js", "content.js", "subtitle-panel.js", "video-favorite.js", "video-shortcuts.js", "touch-lookup.js", "mobile-drawer.js", "player-controls.js", "study-tracker.js"],
      "css": ["vendor/content.css"]
    },
    {
      "matches": ["<all_urls>"],
      "js": ["frame-gate.js"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["*://*.netflix.com/*"],
      "js": ["netflix-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["youtube-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.tver.jp/*",
        "*://*.bilibili.tv/*",
        "*://www.hulu.jp/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.com/*",
        "*://*.amazon.co.jp/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.de/*",
        "*://*.amazon.fr/*",
        "*://*.amazon.it/*",
        "*://*.amazon.es/*"
      ],
      "js": ["stream-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["vendor/content.css", "nested-popup.html", "dict-frame.html", "dict-sandbox.html", "locales/*.json", "icon-32.png"], "matches": ["<all_urls>"] },
    { "resources": ["side-panel.html", "side-panel.css", "side-panel.js", "video-favorite.js", "popup-size.js", "locales/en.js", "i18n.js", "material-color.js", "theme-palette.js", "theme.js", "icons.js", "theme.css", "material.css", "glass-select.js", "auto-read.js", "ruby-render.js", "vendor/selection.js", "vendor/dict-media.js", "vendor/popup.js"], "matches": ["<all_urls>"] }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self'",
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'unsafe-inline' 'unsafe-eval'; style-src 'unsafe-inline' data:; img-src data: blob:; font-src data:; media-src data: blob:; connect-src 'none'; form-action 'none'; base-uri 'none'; frame-src 'none'"
  },
  "sandbox": { "pages": ["dict-sandbox.html"] },
  "options_page": "options.html",
  "side_panel": { "default_path": "side-panel.html" },
  "action": { "default_title": "Fushi Reader Bridge", "default_popup": "vendor/action-popup.html", "default_icon": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" } }
}

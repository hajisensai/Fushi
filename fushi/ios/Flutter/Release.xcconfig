#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"
// iOS 伞形 Rust 静态库（互联 P2P 隧道 fp2p_* + SRS 排程内核 ffsrs_* + 计算内核 ffc_* 合一，
// std 只有一份）：native/fushi_ios_umbrella/build_ios_staticlib.sh 生成。这里仍是可选 include，
// 但计算内核 fushi_compute 是硬依赖：没编过（或是加入 fushi_compute 之前的旧件）时 Runner 的
// 「Check fushi_compute (iOS umbrella)」构建阶段（ios/check_fushi_compute.sh）让构建失败；RWKV 排程推理
// fushi_rwkv（frwkv_*）同为硬依赖，由「Check fushi_rwkv (iOS umbrella)」（ios/check_fushi_rwkv.sh）把关。
// 见 Runner 的 OTHER_LDFLAGS。
#include? "../../../native/fushi_ios_umbrella/prebuilt/ios/fushi_ios_umbrella.xcconfig"
// APNs 环境（Runner/Runner.entitlements 的 aps-environment）。只在接入了那份 entitlements
// 时才起作用：CI 在描述文件带 aps-environment 时追加 CODE_SIGN_ENTITLEMENTS，并用描述文件
// 里的值覆盖这里。默认不接入，见那个文件的注释。
FUSHI_APS_ENVIRONMENT = production

// 主屏小组件 / Live Activity 与主 app 共用的 App Group（Runner/Runner.entitlements、
// FushiWidgets/FushiWidgets.entitlements、两边 Info.plist 的 FushiAppGroup）。
FUSHI_APP_GROUP = group.app.fushi.reader
// 模拟器不按描述文件核对 entitlements，可以无条件接入（小组件要 App Group 才读得到快照）；
// 真机只由 CI 按描述文件实际带了哪些 entitlement 接入，见 Runner.entitlements 的注释。
CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*] = Runner/Runner.entitlements

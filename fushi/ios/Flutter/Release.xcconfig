#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"
// iOS 伞形 Rust 静态库（互联 P2P 隧道 fp2p_* + SRS 排程内核 ffsrs_* 合一，std 只有一份）：
// native/fushi_ios_umbrella/build_ios_staticlib.sh 生成，没编过就缺席（FUSHI_IOS_NATIVE_LDFLAGS
// 为空、不链接、P2P 与 SRS 复习判不可用）。见 Runner 的 OTHER_LDFLAGS。
#include? "../../../native/fushi_ios_umbrella/prebuilt/ios/fushi_ios_umbrella.xcconfig"
// APNs 环境（Runner/Runner.entitlements 的 aps-environment）。只在接入了那份 entitlements
// 时才起作用：CI 在描述文件带 aps-environment 时追加 CODE_SIGN_ENTITLEMENTS，并用描述文件
// 里的值覆盖这里。默认不接入，见那个文件的注释。
FUSHI_APS_ENVIRONMENT = production

    "widget.word.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة حفظتها أو صنعت منها بطاقة مؤخرًا، مع جملتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wort, das du kürzlich gespeichert oder zu einer Karte gemacht hast, mit seinem Satz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A word you recently saved or made a card from, with its sentence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una palabra que guardaste o convertiste en tarjeta hace poco, con su frase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mot que vous avez récemment enregistré ou transformé en carte, avec sa phrase."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata yang baru saja kamu simpan atau jadikan kartu, beserta kalimatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parola che hai salvato o trasformato in scheda di recente, con la sua frase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近保存した・カードにした単語を、その例文と一緒に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 저장했거나 카드로 만든 단어와 그 문장."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een woord dat je onlangs hebt bewaard of tot kaart hebt gemaakt, met de zin erbij."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma palavra que você salvou ou transformou em cartão recentemente, com a frase."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слово, которое вы недавно сохранили или превратили в карточку, вместе с предложением."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำที่คุณเพิ่งบันทึกหรือทำเป็นการ์ด พร้อมประโยคของคำนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakın zamanda kaydettiğin ya da karta dönüştürdüğün bir kelime, cümlesiyle birlikte."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một từ bạn vừa lưu hoặc tạo thẻ, kèm câu chứa nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近收藏或制卡的一个词，附带它的原句。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

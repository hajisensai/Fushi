          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cartão do seu baralho, com a frase de onde você o salvou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карточка из вашей колоды с исходным предложением."

    "widget.continue.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع الكتب والفيديوهات والألعاب من حيث توقفت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bücher, Videos und Spiele dort fortsetzen, wo du aufgehört hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick up books, videos and games where you left off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retoma libros, vídeos y juegos donde los dejaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprenez livres, vidéos et jeux là où vous les avez laissés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan buku, video, dan game dari terakhir kali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprendi libri, video e giochi da dove eri rimasto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本・動画・ゲームを前回の続きから。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책, 영상, 게임을 멈춘 곳부터 이어서."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga verder met boeken, video’s en games waar je was gebleven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retome livros, vídeos e jogos de onde parou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжайте книги, видео и игры с того места, где остановились."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านหนังสือ ดูวิดีโอ และเล่นเกมต่อจากที่ค้างไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplara, videolara ve oyunlara kaldığın yerden devam et."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục sách, video và trò chơi từ chỗ đã dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从上次停下的地方接着读书、看视频、玩游戏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從上次停下的地方繼續讀書、看影片、玩遊戲。"
          }
        }
      }
    },

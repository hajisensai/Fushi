    "widget.heatmap.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستة عشر أسبوعًا من وقت الدراسة في لمحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sechzehn Wochen Lernzeit auf einen Blick."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sixteen weeks of study time at a glance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieciséis semanas de estudio de un vistazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seize semaines de temps d’étude en un coup d’œil."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu belajar 16 minggu dalam sekali lihat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedici settimane di studio a colpo d’occhio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近 16 週間の学習時間をひと目で。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 16주 학습 시간을 한눈에."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zestien weken studietijd in één oogopslag."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezesseis semanas de estudo num relance."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шестнадцать недель занятий одним взглядом."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาเรียน 16 สัปดาห์ในพริบตา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "On altı haftalık çalışma süresi bir bakışta."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mười sáu tuần học tập trong nháy mắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼看完最近 16 周的学习时长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼看完最近 16 週的學習時長。"
          }
        }
      }
    },

{
  "sourceLanguage": "en",
  "strings": {
    "widget.audiobook.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع كتابك الصوتي بنقرة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hörbuch mit einem Tipp fortsetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume your audiobook with one tap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retoma tu audiolibro con un toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprenez votre livre audio d’un geste."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan buku audio dengan satu ketukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprendi l’audiolibro con un tocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタップでオーディオブックの続きを再生。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 오디오북을 이어 듣기."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga met één tik verder met je luisterboek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retome seu audiolivro com um toque."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжите аудиокнигу одним касанием."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟังหนังสือเสียงต่อได้ในแตะเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesli kitabına tek dokunuşla devam et."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nghe tiếp sách nói chỉ với một chạm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一键接着听有声书。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一鍵繼續聽有聲書。"
          }
        }
      }
    },

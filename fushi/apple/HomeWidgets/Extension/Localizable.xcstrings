{
  "sourceLanguage": "en",
  "strings": {
    "widget.audiobook.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع كتابك الصوتي أو موسيقاك بنقرة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hörbuch oder Musik mit einem Tipp fortsetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume your audiobook or music with one tap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retoma tu audiolibro o tu música con un toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprenez votre livre audio ou votre musique d'un toucher."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan buku audio atau musikmu dengan sekali ketuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprendi il tuo audiolibro o la tua musica con un tocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオブックや音楽をワンタップで再開。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오북이나 음악을 한 번에 이어서 재생하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga met één tik verder met je luisterboek of muziek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retome seu audiolivro ou sua música com um toque."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжайте аудиокнигу или музыку одним касанием."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นหนังสือเสียงหรือเพลงต่อได้ในแตะเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesli kitabını ya da müziğini tek dokunuşla sürdür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục sách nói hoặc nhạc chỉ với một chạm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一键继续播放有声书或音乐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一鍵繼續播放有聲書或音樂。"
          }
        }
      }
    },
    "widget.audiobook.name": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متابعة الاستماع"

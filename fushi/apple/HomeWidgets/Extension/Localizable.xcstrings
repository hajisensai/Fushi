    "widget.heatmap.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت الدراسة في آخر خمسة أسابيع في لمحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lernzeit der letzten fünf Wochen auf einen Blick."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last five weeks of study time at a glance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu tiempo de estudio de las últimas cinco semanas de un vistazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre temps d'étude des cinq dernières semaines en un coup d'œil."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu belajar lima minggu terakhir dalam sekilas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo di studio delle ultime cinque settimane a colpo d'occhio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近 5 週間の学習時間がひと目でわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 5주간의 학습 시간을 한눈에 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je studietijd van de afgelopen vijf weken in één oogopslag."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu tempo de estudo das últimas cinco semanas num relance."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время занятий за последние пять недель с одного взгляда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาเรียนในห้าสัปดาห์ล่าสุดแบบดูได้ในพริบตา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son beş haftanın çalışma süresi bir bakışta."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời gian học trong năm tuần gần nhất, xem nhanh trong nháy mắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼看清最近 5 周的学习时长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼看清最近 5 週的學習時長。"
          }
        }
      }
    },

    "widget.lookup.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن كلمة بالكتابة أو بالكاميرا أو من الحافظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wörter per Eingabe, Kamera oder Zwischenablage nachschlagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look up a word by typing, with the camera, or from the clipboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca palabras escribiendo, con la cámara o desde el portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez un mot par saisie, appareil photo ou presse-papiers."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari kata dengan mengetik, kamera, atau papan klip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca una parola digitando, con la fotocamera o dagli appunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力・カメラ・クリップボードから単語を調べる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",

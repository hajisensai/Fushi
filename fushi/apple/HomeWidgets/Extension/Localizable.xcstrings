    "widget.srs.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البطاقات المستحقة الآن وكيف يزداد عددها خلال اليوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt fällige Karten und wie viele heute noch dazukommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cards due now, and how the count grows through the day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarjetas pendientes ahora y cuántas se suman durante el día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartes à réviser maintenant et celles qui arrivent dans la journée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartu yang jatuh tempo sekarang dan yang menyusul hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carte da ripassare ora e quante se ne aggiungono in giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ復習するカードと、今日この後に増える枚数。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 복습할 카드와 오늘 남은 시간 동안 늘어날 수."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaarten die nu klaarstaan en hoeveel er vandaag nog bijkomen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartões pendentes agora e quantos chegam ao longo do dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карточки к повторению сейчас и сколько добавится за день."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การ์ดที่ถึงกำหนดตอนนี้ และจำนวนที่จะเพิ่มระหว่างวัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi tekrar edilecek kartlar ve gün içinde eklenecekler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thẻ cần ôn ngay và số thẻ sẽ đến hạn trong ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在该复习的卡片，以及今天剩下时间里还会到期多少。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在該複習的卡片，以及今天稍後還會到期多少。"
          }
        }
      }
    },

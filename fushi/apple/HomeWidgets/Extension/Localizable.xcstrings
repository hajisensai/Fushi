    "widget.continue.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع الكتب والمانغا والفيديوهات من حيث توقفت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bücher, Manga und Videos dort fortsetzen, wo du aufgehört hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick up books, manga and videos where you left off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retoma libros, manga y vídeos donde los dejaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprenez livres, mangas et vidéos là où vous vous êtes arrêté."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan buku, manga, dan video dari terakhir kali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprendi libri, manga e video da dove avevi lasciato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本・マンガ・動画を前回の続きから。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책, 만화, 동영상을 멈춘 곳부터 이어 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga verder met boeken, manga en video's waar je gebleven was."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue livros, mangás e vídeos de onde parou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжайте книги, мангу и видео с того места, где остановились."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านหนังสือ มังงะ และดูวิดีโอต่อจากที่ค้างไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplara, mangalara ve videolara kaldığın yerden devam et."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục sách, manga và video từ chỗ bạn dừng lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从上次停下的地方继续书籍、漫画和视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從上次停下的地方繼續書籍、漫畫和影片。"
          }
        }
      }
    },

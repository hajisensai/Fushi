    "widget.word.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بطاقة من مجموعتك مع الجملة التي حفظتها منها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Karte aus deinem Stapel mit dem Satz, aus dem du sie gespeichert hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A card from your own deck, with the sentence you saved it from."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta de tu mazo con la frase de la que la guardaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte de votre paquet, avec la phrase d’origine."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu kartu dari dek Anda beserta kalimat asalnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carta del tuo mazzo con la frase da cui l’hai salvata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のデッキから 1 枚、保存したときの例文つき。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 덱에서 고른 카드 한 장과 저장할 때의 예문."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",

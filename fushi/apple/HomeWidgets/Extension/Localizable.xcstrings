    "widget.srs.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البطاقات المستحقة اليوم، مقسّمة إلى جديدة وقيد التعلّم ومراجعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute fällige Karten, aufgeteilt in neu, lernen und wiederholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cards due today, split into new, learning and review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarjetas pendientes hoy, divididas en nuevas, en aprendizaje y repaso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartes à réviser aujourd'hui, réparties en nouvelles, en apprentissage et révision."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartu yang jatuh tempo hari ini, dibagi menjadi baru, belajar, dan ulasan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Schede da ripassare oggi, divise in nuove, in apprendimento e ripasso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の復習カード（新規・学習中・復習の内訳）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 복습할 카드(새 카드·학습 중·복습)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaarten die vandaag aan de beurt zijn, verdeeld in nieuw, leren en herhalen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartões para hoje, divididos em novos, em aprendizado e revisão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карточки на сегодня: новые, изучаемые и на повторение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การ์ดที่ถึงกำหนดวันนี้ แยกเป็นใหม่ กำลังเรียน และทบทวน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün vadesi gelen kartlar; yeni, öğreniliyor ve tekrar olarak ayrılmış."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thẻ đến hạn hôm nay, chia thành mới, đang học và ôn tập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天待复习的卡片，按新卡、学习中、复习分开显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天待複習的卡片，按新卡、學習中、複習分開顯示。"
          }
        }
      }
    },

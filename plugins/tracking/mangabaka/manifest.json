{
  "schema": 1,
  "kind": "tracking",
  "id": "moe.fushi.tracking.mangabaka",
  "name": "MangaBaka",
  "version": "0.1.3",
  "api": 1,
  "entry": "main.js",
  "description": "Keeps your MangaBaka library in step with the manga and novels you read in Fushi.",
  "capabilities": ["login", "account", "trackingEntry", "trackingSubject", "trackingSearch", "trackingLookup"],
  "permissions": ["network", "credentials"],
  "network": { "domains": ["api.mangabaka.org", "mangabaka.org"], "methods": ["GET", "POST", "PATCH"] },
  "tracking": {
    "siteId": "mangabaka",
    "siteHost": "mangabaka.org",
    "kinds": ["manga", "novel"],
    "defaultKinds": ["manga", "novel"],
    "modes": ["chapter", "volume"],
    "requestsPerMinute": 30,
    "subjectUrl": "https://mangabaka.org/{id}"
  }
}

{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tool/claude_hooks/subagent_model_router.mjs\"", "timeout": 10 }]
      },
      {
        "matcher": "Workflow",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tool/claude_hooks/workflow_agent_type_default.mjs\"", "timeout": 10 }]
      }
    ]
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Edit(.claude/settings.local.json)",
      "Write(.claude/settings.local.json)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)"
    ]
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  }
}

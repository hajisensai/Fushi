+            goto fail;
+        }
+        ret = ff_tls_check_cert_pin(h, cert_ctx->pbCertEncoded,
+                                    cert_ctx->cbCertEncoded, s->pin_sha256);
+        CertFreeCertificateContext(cert_ctx);
+        if (ret < 0)
+            goto fail;
+    }

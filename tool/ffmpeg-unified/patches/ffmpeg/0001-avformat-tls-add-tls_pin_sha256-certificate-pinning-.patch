diff --git a/libavformat/tls_securetransport.c b/libavformat/tls_securetransport.c
index f52fc97..3023c79 100644
--- a/libavformat/tls_securetransport.c
+++ b/libavformat/tls_securetransport.c
@@ -296,6 +296,33 @@ static int tls_open(URLContext *h, const char *uri, int flags, AVDictionary **op
         if (status == errSSLServerAuthCompleted) {
             SecTrustRef peerTrust;
             SecTrustResultType trustResult;
+            if (ff_tls_has_cert_pin(s)) {
+                /* Fushi: certificate fingerprint pinning is authoritative and
+                 * replaces the anchor/hostname trust evaluation below (verify
+                 * was cleared by the shared open path, so BreakOnServerAuth is
+                 * set); accept the leaf certificate iff it matches the pin. */
+                SecTrustRef pinTrust = NULL;
+                CFDataRef der = NULL;
+                int pinret = AVERROR(EIO);
+                if (SSLCopyPeerTrust(c->ssl_context, &pinTrust) == noErr && pinTrust) {
+                    if (SecTrustGetCertificateCount(pinTrust) > 0)
+                        der = SecCertificateCopyData(
+                            SecTrustGetCertificateAtIndex(pinTrust, 0));
+                    if (der)
+                        pinret = ff_tls_check_cert_pin(h, CFDataGetBytePtr(der),
+                                                       (int)CFDataGetLength(der),
+                                                       s->pin_sha256);
+                }
+                if (der)
+                    CFRelease(der);
+                if (pinTrust)
+                    CFRelease(pinTrust);
+                if (pinret < 0) {
+                    ret = pinret;
+                    goto fail;
+                }
+                continue; /* pinned certificate matched: re-drive the handshake */
+            }
             if (!s->verify)
                 continue;
 

+#ifdef __ANDROID__
+#include <dirent.h>
+#include <stdio.h>
+#include <openssl/pem.h>
+
+/* Fushi: Android ships no OpenSSL CA bundle at the compiled-in default path,
+ * and its system store directories name files by the legacy (MD5) subject
+ * hash, which OpenSSL >= 1.0 hashed-dir lookup cannot resolve. With FFmpeg's
+ * verify-by-default this would fail every public HTTPS handshake, so load the
+ * system/updatable trust stores into the X509_STORE explicitly (one PEM per
+ * file). Returns the number of certificates added. */
+static int openssl_load_android_system_cas(SSL_CTX *ctx)
+{
+    static const char *const dirs[] = {
+        "/apex/com.android.conscrypt/cacerts", /* Android 14+: updatable store */
+        "/system/etc/security/cacerts",
+    };
+    X509_STORE *store = SSL_CTX_get_cert_store(ctx);
+    char path[512];
+    int added = 0;
+    int d;
+
+    if (!store)
+        return 0;
+    for (d = 0; d < FF_ARRAY_ELEMS(dirs); d++) {
+        DIR *dir = opendir(dirs[d]);
+        struct dirent *ent;
+        if (!dir)
+            continue;
+        while ((ent = readdir(dir))) {
+            FILE *f;
+            X509 *x;
+            if (ent->d_name[0] == '.')
+                continue;
+            snprintf(path, sizeof(path), "%s/%s", dirs[d], ent->d_name);
+            f = fopen(path, "r");
+            if (!f)
+                continue;
+            while ((x = PEM_read_X509(f, NULL, NULL, NULL))) {
+                if (X509_STORE_add_cert(store, x))
+                    added++;
+                X509_free(x);
+            }
+            ERR_clear_error(); /* PEM EOF / duplicate-cert noise is expected */
+            fclose(f);
+        }
+        closedir(dir);
+        /* The updatable APEX store supersedes the legacy one when present. */
+        if (added > 0)
+            break;
+    }
+    return added;
+}
+#endif
+
 static av_cold int openssl_init_ca_key_cert(URLContext *h)
 {
     int ret;
@@ -708,6 +763,13 @@ static av_cold int openssl_init_ca_key_cert(URLContext *h)
             av_log(h, AV_LOG_WARNING, "Failure setting default verify locations: %s\n",
                 openssl_get_error(c));
         }
+#ifdef __ANDROID__
+        if (s->verify) {
+            int n = openssl_load_android_system_cas(c->ctx);
+            av_log(h, n > 0 ? AV_LOG_DEBUG : AV_LOG_WARNING,
+                   "Loaded %d Android system CA certificates\n", n);
+        }
+#endif
     }
 
     if (s->cert_file) {
@@ -918,6 +980,34 @@ static int tls_open(URLContext *h, const char *uri, int flags, AVDictionary **op
         }
     }
 
+    if (ff_tls_has_cert_pin(s)) {
+        /* Fushi: certificate fingerprint pinning. Authoritative: the shared
+         * open path turned CA/hostname verification off, so a self-signed LAN
+         * host is accepted iff its leaf certificate matches the pin. */
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+        X509 *peer = SSL_get1_peer_certificate(c->ssl);
+#else
+        X509 *peer = SSL_get_peer_certificate(c->ssl);
+#endif
+        unsigned char *der = NULL;
+        int der_len;
+        int pinret = AVERROR(EIO);
+        if (peer) {
+            der_len = i2d_X509(peer, &der);
+            if (der_len > 0 && der)
+                pinret = ff_tls_check_cert_pin(h, der, der_len, s->pin_sha256);
+            if (der)
+                OPENSSL_free(der);
+            X509_free(peer);
+        } else {
+            av_log(h, AV_LOG_ERROR, "No peer certificate to pin against\n");
+        }
+        if (pinret < 0) {
+            ret = pinret;
+            goto fail;
+        }
+    }
+
     return 0;
 fail:
     tls_close(h);
diff --git a/libavformat/tls_schannel.c b/libavformat/tls_schannel.c
index 6708302..bef1baf 100644
--- a/libavformat/tls_schannel.c
+++ b/libavformat/tls_schannel.c
@@ -1103,6 +1103,28 @@ static int tls_handshake(URLContext *h)
     }
 #endif
 
+    if (!s->listen && ff_tls_has_cert_pin(s)) {
+        /* Fushi: certificate fingerprint pinning replaces the chain validation
+         * (SCH_CRED_MANUAL_CRED_VALIDATION, since the shared open path cleared
+         * verify), accepting exactly the pinned leaf certificate. */
+        PCCERT_CONTEXT cert_ctx = NULL;
+        sspi_ret = QueryContextAttributes(&c->ctxt_handle,
+                                          SECPKG_ATTR_REMOTE_CERT_CONTEXT,
+                                          &cert_ctx);
+        if (sspi_ret != SEC_E_OK || !cert_ctx) {
+            av_log(h, AV_LOG_ERROR,
+                   "Unable to retrieve peer certificate for pinning (0x%lx)\n",

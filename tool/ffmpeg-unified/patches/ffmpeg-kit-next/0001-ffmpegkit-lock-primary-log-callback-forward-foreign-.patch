From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fushi <fushi@localhost>
Date: Sat, 17 Oct 2026 19:40:40 +0800
Subject: [PATCH] ffmpegkit: lock primary log callback, forward foreign
 messages to libmpv

---
 .../src/main/cpp/ffmpegkit.c                         | 12 ++++++++++--
 apple/src/FFmpegKitConfig.m                          | 12 ++++++++++--
 2 files changed, 20 insertions(+), 4 deletions(-)

diff --git a/android/ffmpeg-kit-next-android-lib/src/main/cpp/ffmpegkit.c b/android/ffmpeg-kit-next-android-lib/src/main/cpp/ffmpegkit.c
index 01bc01f..74a43ad 100644
--- a/android/ffmpeg-kit-next-android-lib/src/main/cpp/ffmpegkit.c
+++ b/android/ffmpeg-kit-next-android-lib/src/main/cpp/ffmpegkit.c
@@ -662,6 +662,14 @@ void ffmpegkit_log_callback_function(void *ptr, int level, const char *format,
         level &= 0xff;
     }
 
+    // Fushi: the FFmpeg build is shared in-process with libmpv. Messages from
+    // threads that run no FFmpegKit session belong to the other client: hand
+    // them to its (secondary) callback instead of swallowing them.
+    if (globalSessionId == 0) {
+        av_log_fushi_forward_secondary(ptr, level, format, vargs);
+        return;
+    }
+
     // Run -report / -show_log capture for every line, independent of the console
     // log-level filter below (the report keeps its own report_file_level threshold).
     run_duties(ptr, level, format, vargs);
@@ -1447,7 +1455,7 @@ static void enableNativeRedirection() {
         return;
     }
 
-    av_log_set_callback(ffmpegkit_log_callback_function);
+    av_log_fushi_set_primary_callback(ffmpegkit_log_callback_function);
     set_report_callback(ffmpegkit_statistics_callback_function);
 }
 
@@ -1614,7 +1622,7 @@ Java_com_arthenica_ffmpegkit_FFmpegKitConfig_disableNativeRedirection(
 
     mutexUnlock();
 
-    av_log_set_callback(ffmpegkit_log_callback_default);
+    av_log_fushi_set_primary_callback(NULL);
     set_report_callback(NULL);
 
     monitorNotify();
diff --git a/apple/src/FFmpegKitConfig.m b/apple/src/FFmpegKitConfig.m
index 6275018..fbbfce6 100644
--- a/apple/src/FFmpegKitConfig.m
+++ b/apple/src/FFmpegKitConfig.m
@@ -1166,6 +1166,14 @@ void ffmpegkit_log_callback_function(void *ptr, int level, const char *format,
         level &= 0xff;
     }
 
+    // Fushi: the FFmpeg build is shared in-process with libmpv. Messages from
+    // threads that run no FFmpegKit session belong to the other client: hand
+    // them to its (secondary) callback instead of swallowing them.
+    if (globalSessionId == 0) {
+        av_log_fushi_forward_secondary(ptr, level, format, vargs);
+        return;
+    }
+
     // Run -report / -show_log capture for every line, independent of the console
     // log-level filter below (the report keeps its own report_file_level threshold).
     run_duties(ptr, level, format, vargs);
@@ -1969,7 +1977,7 @@ int executeFFprobe(long sessionId, NSArray *arguments) {
           callbackBlockFunction();
         });
 
-    av_log_set_callback(ffmpegkit_log_callback_function);
+    av_log_fushi_set_primary_callback(ffmpegkit_log_callback_function);
     set_report_callback(ffmpegkit_statistics_callback_function);
 }
 
@@ -1984,7 +1992,7 @@ int executeFFprobe(long sessionId, NSArray *arguments) {
 
     [lock unlock];
 
-    av_log_set_callback(ffmpegkit_log_callback_default);
+    av_log_fushi_set_primary_callback(NULL);
     set_report_callback(nil);
 
     callbackNotify();

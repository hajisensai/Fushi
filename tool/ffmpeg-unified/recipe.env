# Fushi unified FFmpeg recipe: the single source of truth for which FFmpeg every
# platform ships. The player (libmpv) and card mining / export (ffmpeg CLI on
# desktop, FFmpegKit on Android/iOS) link the SAME FFmpeg build on each
# platform, and every platform builds it from this version + these patches.
# See docs/specs/2026-10-17-unified-ffmpeg.md.
#
# Sourced by bash (KEY=value, no spaces) and parsed by the guard tests.

FFMPEG_VERSION=9.0.1
FFMPEG_TAG=n9.0.1
# Peeled commit of the upstream tag (identical in arthenica/FFmpeg, which
# FFmpegKitNext clones by default).
FFMPEG_COMMIT=bf1b838f2ab88b4f8fd83443325c782ea0e0f7fa
FFMPEG_REPO=https://github.com/FFmpeg/FFmpeg.git

# In-process command runner for Android/iOS (fftools as a library).
FFMPEG_KIT_NEXT_TAG=v9.0.0
FFMPEG_KIT_NEXT_COMMIT=a724ed99583dcfe2af497c794fdd6b24ddd54a4e
FFMPEG_KIT_NEXT_REPO=https://github.com/arthenica/ffmpeg-kit-next.git

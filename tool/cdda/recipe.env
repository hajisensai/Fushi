# Fushi audio CD (cdda://) native recipe for the Windows libmpv runtime
# (docs/specs/2026-10-23-music-module-design.md, P5 audio CD playback).
#
# libmpv's cdda stream (-Dcdda=enabled) links libcdio_paranoia -> libcdio_cdda
# -> libcdio. Windows takes them as pinned MSYS2 binary packages, unpacked into
# a PRIVATE prefix by tool/cdda/fetch_cdio_msys2.py (never `pacman -S` into the
# shared MSYS2 install, which would change the build machine for everything
# else). Each package file is checked against the SHA256 below before use.
# libcdio's own runtime dependency on libcddb is not linked by these three DLLs
# (verified with objdump on libcdio-19.dll), so it is not fetched.
#
# Both libraries are GPL-3.0-or-later (COPYING and the source headers of the
# upstream tarballs inside the MSYS2 source packages); the license texts the
# archive ships are native/third_party_licenses/texts/cdda/.
#
# Android / iOS have no optical drives and do not build cdda; macOS builds it
# in the libmpv-darwin-build fork (tool/bluray/forks/README.md); Linux uses the
# system mpv (docs/agent/build.md).
#
# Parsed by fetch_cdio_msys2.py, package_libmpv.py and the guard tests
# (KEY=value, no spaces).

LIBCDIO_PACKAGE=mingw-w64-x86_64-libcdio-2.3.0-1-any.pkg.tar.zst
LIBCDIO_VERSION=2.3.0-1
LIBCDIO_URL=https://repo.msys2.org/mingw/mingw64/mingw-w64-x86_64-libcdio-2.3.0-1-any.pkg.tar.zst
LIBCDIO_SHA256=e8ce99bccac484cf481791a112ae836200ca247a5b85cd47477b50d9de281ca9
LIBCDIO_SOURCE_URL=https://repo.msys2.org/mingw/sources/mingw-w64-libcdio-2.3.0-1.src.tar.zst
LIBCDIO_SOURCE_SHA256=d2cf5c1b9fb556072a4301ee6b2dc0545398574eb284feec5b90a9e027b04f31

LIBCDIO_PARANOIA_PACKAGE=mingw-w64-x86_64-libcdio-paranoia-10.2+2.0.2-1-any.pkg.tar.zst
LIBCDIO_PARANOIA_VERSION=10.2+2.0.2-1
LIBCDIO_PARANOIA_URL=https://repo.msys2.org/mingw/mingw64/mingw-w64-x86_64-libcdio-paranoia-10.2%2B2.0.2-1-any.pkg.tar.zst
LIBCDIO_PARANOIA_SHA256=298bf8ef059f2d07448480a63fe6dd3f9c159303244e2e391d4737349db0abde
LIBCDIO_PARANOIA_SOURCE_URL=https://repo.msys2.org/mingw/sources/mingw-w64-libcdio-paranoia-10.2%2B2.0.2-1.src.tar.zst
LIBCDIO_PARANOIA_SOURCE_SHA256=614a774727770008df7f036d645127c09ba37094ebf940b40fe21e5dc8bcb0bc

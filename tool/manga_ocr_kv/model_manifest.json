          "shape": [4, "beams", 12, "present_length", 64]
        }
      ],
      "firstStepPast": [4, 1, 12, 1, 64],
      "notes": "past slot 0 is a zero placeholder that attention never reads; present keeps it so present can be fed back as the next past. beam_idx gathers the past per beam inside the graph."

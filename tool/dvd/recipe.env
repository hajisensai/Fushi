# Fushi DVD native recipe: the single source of truth for the DVD libraries
# every platform ships (docs/specs/2026-10-24-dvd-original-menu.md).
#
#   libdvdcss  -> libdvdread (linked directly against libdvdcss, i.e. the
#                 autotools-era --with-libdvdcss; meson -Dlibdvdcss=enabled)
#              -> libdvdnav
#
# ONE build per platform: libmpv (-Ddvdnav=enabled, dvd:// menus) and the
# unified FFmpeg (--enable-libdvdnav --enable-libdvdread, dvdvideo demuxer)
# link the same shared libraries. All three are GPL-2.0-or-later.
#
# Sourced by bash (KEY=value, no spaces) and parsed by the guard tests.
# The SHA256 values were checked against the .sha256 files VideoLAN publishes
# next to each tarball (2026-10-24).

LIBDVDCSS_VERSION=1.6.0
LIBDVDCSS_URL=https://download.videolan.org/pub/videolan/libdvdcss/1.6.0/libdvdcss-1.6.0.tar.xz
LIBDVDCSS_SHA256=7ea556c846b7bfc32d47b41cae56d1863a6b6d5f706bb162778d6f298490977c

LIBDVDREAD_VERSION=7.1.1
LIBDVDREAD_URL=https://download.videolan.org/pub/videolan/libdvdread/7.1.1/libdvdread-7.1.1.tar.xz
LIBDVDREAD_SHA256=a0d47876548bec806774bbf8dbf20bb19ba139464383156b32eb8e59915b90a9

LIBDVDNAV_VERSION=7.0.0
LIBDVDNAV_URL=https://download.videolan.org/pub/videolan/libdvdnav/7.0.0/libdvdnav-7.0.0.tar.xz
LIBDVDNAV_SHA256=a2a18f5ad36d133c74bf9106b6445806fa253b09141a46392550394b647b221e

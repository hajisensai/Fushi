libdvdcss: build without DVD drive ioctls when FUSHI_DVDCSS_NO_DRIVE is set

iOS has no optical drives and no IOKit DVD media client, so upstream ioctl.c
stops at "#error DVD ioctls are unavailable on this system". Fushi only opens
image files there (ISO / VIDEO_TS), which libdvdcss reads without ioctls (CSS
title keys are cracked from the image), so each ioctl reports failure instead.
Only tool/dvd/platforms/build_cross.sh ios-* defines the macro; every other
platform compiles the upstream code unchanged.

--- a/src/ioctl.c
+++ b/src/ioctl.c
@@ -230,6 +230,10 @@
 
     *pi_copyright = p_buffer[ 4 ];
 
+#elif defined( FUSHI_DVDCSS_NO_DRIVE )
+    /* Fushi: no optical drive (iOS); image files never reach the ioctls. */
+    i_ret = -1;
+
 #else
 #   error "DVD ioctls are unavailable on this system"
 

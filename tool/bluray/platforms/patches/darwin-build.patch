+      -Dmacos-10-12-2-features=disabled `# macOS 10.12.2 SDK Features`
+      -Dmacos-10-14-features=disabled `# macOS 10.14 SDK Features`
+      -Dmacos-cocoa-cb=disabled `# macOS libmpv backend`

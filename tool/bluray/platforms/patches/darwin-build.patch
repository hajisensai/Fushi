+      -Daudiounit=enabled `# AudioUnit output for iOS`
+    )
+
+    IOS_VIDEO_OPTIONS=(
+      `# hwaccel features`
+      -Dios-gl=enabled `# iOS OpenGL ES hardware decoding interop support`
+    )
